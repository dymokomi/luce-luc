## Applications: `luc install owner/name` fetches the source, builds it, and installs
## what the package's install script asks for into ~/.luce/apps/<name>/<version>/.
##
## The script is high-level Luce run with `luce run --sandbox`, so it has no file,
## network or process access. It receives `<os> <arch> <name> <version>` and prints a
## plan, one instruction a line:
##     copy <path-in-package> -> <path-in-install-directory>
##     link <command-name> -> <path-in-install-directory>
## luc validates every path and does the copying. A package without a script gets
## the default: its built executable as bin/<name>, linked as <name>.
import c
import files
import memory
import os
import paths
import process
import strings
import pkg

pub let invalid = pkg.invalid
let max_plan_lines: usize = 1024

func ensure_directory(path: str) -> !:
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    if not files.exists((c.str)terminated): try files.create_directory((c.str)terminated)

func exists(path: str) -> bool!:
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    return files.exists((c.str)terminated)

## ~/.luce (or LUC_HOME), created as needed.
pub func home() -> str!:
    if let chosen = os.env((c.str)"LUC_HOME"):
        try ensure_directory(chosen)
        return try strings.copy(chosen)
    let user = os.env((c.str)"HOME") else error(invalid, "HOME is not set; set LUC_HOME")
    let directory = try paths.join(user, ".luce")
    errdefer strings.release(directory)
    try ensure_directory(directory)
    return directory

pub func child(parent: str, name: str) -> str!:
    let directory = try paths.join(parent, name)
    errdefer strings.release(directory)
    try ensure_directory(directory)
    return directory

## Relative, `/`-separated, no empty, `.` or `..` segment, backslash, colon or control byte.
func path_valid(value: str) -> bool:
    if value.length == 0 or value.length > 1024: return false
    var start: usize
    for end in 0..<value.length + 1:
        if end != value.length:
            let byte = value.bytes[end]
            if byte < 0x20 or byte == 0x7f or byte == '\\' or byte == ':': return false
            if byte != '/': continue
        let part = (str)value.bytes[start..<end]
        if part.length == 0 or part == "." or part == "..": return false
        start = end + 1
    return true

func command_valid(value: str) -> bool:
    if value.length == 0 or value.length > 64: return false
    for i in 0..<value.length:
        let byte = value.bytes[i]
        let alnum = (byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9')
        if not alnum and (i == 0 or (byte != '_' and byte != '-')): return false
    return true

## Copy a regular file or a whole directory tree. Symlinks and special files are refused,
## so nothing in a package can make the copy reach outside it.
func copy_tree(source: str, destination: str, budget: usize*) -> !:
    if *budget == 0: error(invalid, "an install copies too many files")
    *budget -= 1
    let origin = try strings.copy(source)
    defer strings.release(origin)
    let target = try strings.copy(destination)
    defer strings.release(target)
    let info = try files.metadata((c.str)origin, follow_symlinks = false)
    if info.kind == files.FileKind.regular:
        discard(try files.copy_file((c.str)origin, (c.str)target, permissions = info.permissions & 0o777))
        return
    if info.kind != files.FileKind.directory: error(invalid, "an install may copy only regular files and directories")
    try files.create_directory((c.str)target)
    let names = try files.list((c.str)origin)
    defer files.release_list(names)
    for name in names:
        let inner_source = try paths.join(source, name)
        defer strings.release(inner_source)
        let inner_destination = try paths.join(destination, name)
        defer strings.release(inner_destination)
        try copy_tree(inner_source, inner_destination, budget)

## Create the parent directories of a relative path below `root`.
func ensure_parents(root: str, relative: str) -> !:
    var current = try strings.copy(root)
    defer strings.release(current)
    var start: usize
    for end in 0..<relative.length:
        if relative.bytes[end] != '/': continue
        let next = try paths.join(current, (str)relative.bytes[start..<end])
        strings.release(current)
        current = next
        try ensure_directory(current)
        start = end + 1

## Split `verb left -> right`. Paths may contain spaces, so only the arrow separates them.
func instruction(line: str) -> (str, str, str)!:
    let (verb, rest) = strings.split_once(line, " ") else error(invalid, "an install plan line is `copy A -> B` or `link NAME -> B`")
    let (left, right) = strings.split_once(rest, " -> ") else error(invalid, "an install plan line is `copy A -> B` or `link NAME -> B`")
    return (verb, strings.trim(left), strings.trim(right))

func release_arguments(arguments: c.str[], filled: usize*):
    for i in 0..<*filled: strings.release((str)arguments[i])

## Run the package's install script in the sandbox and return its plan. The caller
## releases it with process.release.
pub func scripted_plan(luce: str, package_root: str, script: str, name: str, version: str) -> str!:
    let program = try strings.copy(luce)
    defer strings.release(program)
    let script_path = try paths.join(package_root, script)
    defer strings.release(script_path)
    let system = "macos" if os.macos else ("linux" if os.linux else "windows")
    let machine = "arm64" if os.arm64 else "x86_64"
    let words = ["run", "--sandbox", package_root, script_path, "--", system, machine, name, version]
    let argv = try alloc c.str[words.length] in memory.heap
    defer free(argv) in memory.heap
    var filled: usize
    defer release_arguments(argv, &filled)
    while filled < words.length:
        argv[filled] = (c.str)try strings.copy(words[filled])
        filled += 1
    let (status, out, err) = try process.run((c.str)program, argv)
    defer process.release(err)
    if status != 0:
        process.release(out)
        error(invalid, "the install script failed or the sandbox is unavailable on this system")
    return out

## Apply a plan: copies into `staging`, then the command links it declares into `links`
## (one `name<TAB>relative-target` line each), which the caller turns into ~/.luce/bin entries.
pub func apply(plan: str, package_root: str, staging: str, links: u8[], links_used: usize*) -> !:
    var budget: usize = 20000
    var count: usize
    var start: usize
    for end in 0..<plan.length + 1:
        if end != plan.length and plan.bytes[end] != '\n': continue
        let line = strings.trim((str)plan.bytes[start..<end])
        start = end + 1
        if line.length == 0 or line.bytes[0] == '#': continue
        count += 1
        if count > max_plan_lines: error(invalid, "the install plan is too long")
        let (verb, first, second) = try instruction(line)
        if verb == "copy":
            if not path_valid(first) or not path_valid(second): error(invalid, "an install plan path must be relative and stay inside its directory")
            let source = try paths.join(package_root, first)
            defer strings.release(source)
            let destination = try paths.join(staging, second)
            defer strings.release(destination)
            if try exists(destination): error(invalid, "an install plan writes the same path twice")
            try ensure_parents(staging, second)
            try copy_tree(source, destination, &budget)
        elif verb == "link":
            if not command_valid(first) or not path_valid(second): error(invalid, "an install plan link needs a command name and a relative path")
            let needed = first.length + second.length + 2
            if *links_used + needed > links.length: error(invalid, "the install plan declares too many links")
            for byte in first.bytes:
                links[*links_used] = byte
                *links_used += 1
            links[*links_used] = '\t'
            *links_used += 1
            for byte in second.bytes:
                links[*links_used] = byte
                *links_used += 1
            links[*links_used] = '\n'
            *links_used += 1
        else:
            error(invalid, "an install plan line must start with copy or link")
    if count == 0: error(invalid, "the install plan is empty")

# mark: Desktop bundles ========================================================================

func write_text(path: str, text: str) -> !:
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    try files.write((c.str)terminated, text.bytes)

func copy_into(source: str, directory: str, name: str, permissions: u32) -> !:
    let destination = try paths.join(directory, name)
    defer strings.release(destination)
    let origin = try strings.copy(source)
    defer strings.release(origin)
    let target = try strings.copy(destination)
    defer strings.release(target)
    discard(try files.copy_file((c.str)origin, (c.str)target, permissions = permissions))

func fresh_directory(path: str) -> !:
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    if files.exists((c.str)terminated): try files.remove_tree((c.str)terminated)
    try files.create_directory((c.str)terminated)

## The bundle directory name inside build/: "Name.app" on macOS, "Name.AppDir" on Linux,
## empty where luc makes no bundle.
pub func bundle_name(definition: pkg.Definition*, output: u8[]) -> str!:
    if os.macos: return try format(output, f"{definition.application.name}.app")
    if os.linux: return try format(output, f"{definition.application.name}.AppDir")
    return ""

## Wrap the built executable build/<name> as a desktop application, so it opens as an
## application rather than in a terminal. Returns without doing anything on other systems.
pub func bundle(root: str, definition: pkg.Definition*) -> !:
    var name_buffer: u8[96]
    let directory_name = try bundle_name(definition, name_buffer)
    if directory_name.length == 0: return
    let build = try paths.join(root, "build")
    defer strings.release(build)
    let executable = try paths.join(build, definition.name)
    defer strings.release(executable)
    let bundle_root = try paths.join(build, directory_name)
    defer strings.release(bundle_root)
    try fresh_directory(bundle_root)
    var icon_name = ""
    if definition.application.icon.length > 0: icon_name = paths.base(definition.application.icon)
    let icon_source = try paths.join(root, definition.application.icon)
    defer strings.release(icon_source)
    let text = try alloc u8[8192] in memory.heap
    defer free(text) in memory.heap
    if os.macos:
        let contents = try child(bundle_root, "Contents")
        defer strings.release(contents)
        let binaries = try child(contents, "MacOS")
        defer strings.release(binaries)
        let resources = try child(contents, "Resources")
        defer strings.release(resources)
        try copy_into(executable, binaries, definition.name, 0o755)
        if icon_name.length > 0: try copy_into(icon_source, resources, icon_name, 0o644)
        let plist = try paths.join(contents, "Info.plist")
        defer strings.release(plist)
        let icon_entry = try format(text[4096..], f"    <key>CFBundleIconFile</key>\n    <string>{icon_name}</string>\n") if icon_name.length > 0 else ""
        try write_text(plist, try format(text[..<4096], f"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n    <key>CFBundleName</key>\n    <string>{definition.application.name}</string>\n    <key>CFBundleDisplayName</key>\n    <string>{definition.application.name}</string>\n    <key>CFBundleIdentifier</key>\n    <string>{definition.application.identifier}</string>\n    <key>CFBundleExecutable</key>\n    <string>{definition.name}</string>\n    <key>CFBundleVersion</key>\n    <string>{definition.version}</string>\n    <key>CFBundleShortVersionString</key>\n    <string>{definition.version}</string>\n    <key>CFBundlePackageType</key>\n    <string>APPL</string>\n    <key>CFBundleInfoDictionaryVersion</key>\n    <string>6.0</string>\n{icon_entry}    <key>NSHighResolutionCapable</key>\n    <true/>\n    <key>NSPrincipalClass</key>\n    <string>NSApplication</string>\n</dict>\n</plist>\n"))
        return
    # Linux AppDir: AppRun is the executable, with a desktop entry and the icon beside it.
    try copy_into(executable, bundle_root, "AppRun", 0o755)
    if icon_name.length > 0: try copy_into(icon_source, bundle_root, icon_name, 0o644)
    var entry_name: u8[96]
    let desktop = try paths.join(bundle_root, try format(entry_name, f"{definition.name}.desktop"))
    defer strings.release(desktop)
    var stem = icon_name
    for i in 0..<icon_name.length:
        if icon_name.bytes[i] == '.': stem = (str)icon_name.bytes[..<i]
    try write_text(desktop, try format(text[..<4096], f"[Desktop Entry]\nType=Application\nName={definition.application.name}\nExec=AppRun\nIcon={stem}\nTerminal=false\nX-Luce-Identifier={definition.application.identifier}\nX-Luce-Version={definition.version}\n"))

# mark: Where the system looks for applications ===============================================

## The directory the desktop finds applications in: ~/Applications on macOS and
## ~/.local/share/applications on Linux. LUC_APPLICATIONS overrides it. Empty elsewhere.
pub func shelf() -> str!:
    if let chosen = os.env((c.str)"LUC_APPLICATIONS"):
        try ensure_directory(chosen)
        return try strings.copy(chosen)
    let user = os.env((c.str)"HOME") else return try strings.copy("")
    if os.macos: return try child(user, "Applications")
    if not os.linux: return try strings.copy("")
    let dot_local = try child(user, ".local")
    defer strings.release(dot_local)
    let share = try child(dot_local, "share")
    defer strings.release(share)
    return try child(share, "applications")

## Put an installed application where the desktop finds it and return what was created,
## for uninstall to remove. macOS gets a real copy of Name.app, which Spotlight and
## Launchpad index; Linux gets a desktop entry that points at the installed AppDir.
pub func expose(definition: pkg.Definition*, placed_bundle: str) -> str!:
    let directory = try shelf()
    defer strings.release(directory)
    if directory.length == 0: return try strings.copy("")
    if os.macos:
        var name: u8[96]
        let target = try paths.join(directory, try format(name, f"{definition.application.name}.app"))
        errdefer strings.release(target)
        let target_z = try strings.copy(target)
        defer strings.release(target_z)
        if files.exists((c.str)target_z): try files.remove_tree((c.str)target_z)
        var budget: usize = 20000
        try copy_tree(placed_bundle, target, &budget)
        return target
    var name: u8[96]
    let target = try paths.join(directory, try format(name, f"{definition.name}.desktop"))
    errdefer strings.release(target)
    var icon = ""
    if definition.application.icon.length > 0: icon = paths.base(definition.application.icon)
    let text = try alloc u8[4096] in memory.heap
    defer free(text) in memory.heap
    try write_text(target, try format(text, f"[Desktop Entry]\nType=Application\nName={definition.application.name}\nExec=\"{placed_bundle}/AppRun\"\nIcon={placed_bundle}/{icon}\nTerminal=false\nX-Luce-Identifier={definition.application.identifier}\nX-Luce-Version={definition.version}\n"))
    return target

## Remove something expose() created. Only entries directly inside the shelf are touched.
pub func unexpose(path: str) -> !:
    let directory = try shelf()
    defer strings.release(directory)
    if directory.length == 0 or path.length <= directory.length + 1 or not strings.starts_with(path, directory) or path.bytes[directory.length] != '/': return
    for byte in path.bytes[directory.length + 1..]:
        if byte == '/': return
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    if not files.exists((c.str)terminated): return
    let info = try files.metadata((c.str)terminated, follow_symlinks = false)
    if info.kind == files.FileKind.directory: try files.remove_tree((c.str)terminated)
    else: try files.remove_file((c.str)terminated)
