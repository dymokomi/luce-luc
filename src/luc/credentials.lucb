## Encrypted origin-bound session credentials; explicit non-terminal stdin only.
import credential_files as vault
import crypto_native as crypto
import io
import strings
import platform
import files
import c
import account_identity as keys
import luc.registry_http as registry

let invalid: ErrorCode = ErrorCode.package(5)
extern func isatty(descriptor: i32) -> i32

func origin_valid(origin: str) -> bool:
    return registry.valid(origin)

func name_valid(name: str) -> bool:
    if name.length == 0 or name.length > 32: return false
    for byte in name.bytes:
        if not ((byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9') or byte == '_'): return false
    return true

func token_valid(token: const u8[]) -> bool:
    if token.length != 32: return false
    for byte in token:
        if not ((byte >= 'a' and byte <= 'f') or (byte >= '0' and byte <= '9')): return false
    return true

func credential_token_valid(token: const u8[]) -> bool:
    if token.length != 64: return false
    for byte in token:
        if not ((byte >= 'a' and byte <= 'f') or (byte >= '0' and byte <= '9')): return false
    return true

func repository_valid(name: str) -> bool:
    if name.length == 0 or name.length > 64: return false
    for i in 0..<name.length:
        let byte = name.bytes[i]
        let alnum = (byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9')
        if not alnum and (i == 0 or (byte != '_' and byte != '-')): return false
    return true

func scope_valid(scope: str) -> bool:
    return scope == "git:read" or scope == "git:write" or scope == "package:read" or scope == "package:publish"

func input(buffer: u8[]) -> usize!:
    if not (platform.macos or platform.linux): error(invalid, "credential stdin requires POSIX")
    if isatty(0) != 0: error(invalid, "refusing secret input from an echoing terminal; use a private pipe")
    var reader = io.stdin()
    var size: usize = 0
    while size < buffer.length:
        let n = try reader.read(buffer[size..])
        if n == 0: return size
        size += n
    error(invalid, "credential input exceeds bounds")

func quote(value: const u8[], output: u8[]) -> usize!:
    var size: usize = 1
    output[0] = '"'
    let digits = b"0123456789abcdef"
    for byte in value:
        let need: usize = 6 if byte < 32 else (2 if byte == '"' or byte == '\\' else 1)
        if size + need + 1 > output.length: error(invalid, "login JSON exceeds server limit")
        if byte < 32:
            output[size] = '\\'
            output[size + 1] = 'u'
            output[size + 2] = '0'
            output[size + 3] = '0'
            output[size + 4] = digits[byte >> 4]
            output[size + 5] = digits[byte & 15]
        elif need == 2:
            output[size] = '\\'
            output[size + 1] = byte
        else: output[size] = byte
        size += need
    output[size] = '"'
    return size + 1

func revoke_unpublished(published: bool*, origin: str, bearer: str):
    if *published: return
    var output: u8[128]
    defer crypto.wipe(output)
    discard(registry.request(origin, "POST", "/v1/sessions/revoke", bearer,
        "", b"", output, timeout_ms = 5000) catch: recover registry.Response())

## Invitation line, registry password line, EOF. No implicit login or local write.
pub func register(origin: str, account: str) -> i32!:
    if not origin_valid(origin) or not name_valid(account): error(invalid, "invalid registration origin or account")
    var incoming: u8[1060]
    defer crypto.wipe(incoming)
    let size = try input(incoming)
    if size < 35 or size > 1058 or incoming[32] != '\n' or incoming[size - 1] != '\n':
        error(invalid, "expected invitation line then password line and EOF")
    let invitation = incoming[..<32]
    if not token_valid(invitation): error(invalid, "invalid invitation code")
    let password = incoming[33..<size - 1]
    for byte in password:
        if byte == '\n': error(invalid, "unexpected additional password line")
    var request: u8[4096]
    defer crypto.wipe(request)
    let beginning = try format(request, f"{{\"code\":\"{(str)invitation}\",\"name\":\"{account}\",\"password\":")
    var length = beginning.length
    length += try quote(password, request[length..<request.length - 1])
    request[length] = '}'
    length += 1
    var response: u8[128]
    defer crypto.wipe(response)
    let result = try registry.request(origin, "POST", "/v1/invites/redeem", "",
        "application/json", request[..<length], response)
    if result.status != 201: error(invalid, "registration not confirmed; check account state before retrying")
    if (str)response[..<result.count] != "registered": error(invalid, "unexpected registration response; account may exist")
    try io.stdout().write("Registered. Run luc login to create an encrypted session vault.\n")
    return 0

## Password lines are registry password, vault password, then EOF.
pub func login(origin: str, account: str, path: str) -> i32!:
    if not origin_valid(origin) or not name_valid(account) or path.length == 0:
        error(invalid, "invalid login origin, account or vault path")
    for byte in path.bytes:
        if byte == 0: error(invalid, "invalid vault path")
    var exists = true
    discard(files.metadata((c.str)path, follow_symlinks = false) catch failure:
        if failure.code != files.missing: error(failure.code, failure.message)
        exists = false
        recover files.Metadata())
    if exists: error(invalid, "vault destination already exists")
    var incoming: u8[2051]
    defer crypto.wipe(incoming)
    let size = try input(incoming)
    var split: usize = 0
    while split < size and incoming[split] != '\n': split += 1
    if split == 0 or split > 1024 or size < split + 3 or size - split - 2 > 1024 or incoming[size - 1] != '\n':
        error(invalid, "expected registry-password line then vault-password line and EOF")
    for i in split + 1..<size - 1:
        if incoming[i] == '\n': error(invalid, "unexpected additional password line")
    var request: u8[4096]
    defer crypto.wipe(request)
    let beginning = try format(request, f"{{\"name\":\"{account}\",\"password\":")
    var length = beginning.length
    length += try quote(incoming[..<split], request[length..<request.length - 1])
    request[length] = '}'
    length += 1
    var response: u8[4096]
    defer crypto.wipe(response)
    let result = try registry.request(origin, "POST", "/v1/sessions", "",
        "application/json", request[..<length], response)
    if result.status != 200: error(invalid, "registry login failed")
    let token = response[..<result.count]
    if not token_valid(token): error(invalid, "invalid registry session response")
    var bearer_buffer: u8[48]
    defer crypto.wipe(bearer_buffer)
    let bearer = try format(bearer_buffer, f"Bearer {(str)token}")
    var published = false
    errdefer revoke_unpublished(&published, origin, bearer)
    var identity: u8[64]
    let verified = try registry.request(origin, "GET", "/v1/identity", bearer, "", b"", identity)
    if verified.status != 200 or (str)identity[..<verified.count] != account:
        error(invalid, "registry session principal mismatch")
    var payload: u8[256]
    defer crypto.wipe(payload)
    let wire = try format(payload, f"LUC1\n{origin}\n{account}\n{(str)token}\n")
    try vault.create(path, incoming[split + 1..<size - 1], wire.bytes, &published)
    try io.stdout().write("Logged in; stored encrypted registry credential.\n")
    return 0

pub func store(origin: str, account: str, path: str) -> i32!:
    if not origin_valid(origin) or not name_valid(account): error(invalid, "invalid credential origin or account")
    var incoming: u8[1060]
    defer crypto.wipe(incoming)
    let size = try input(incoming)
    var split: usize = 0
    while split < size and incoming[split] != '\n': split += 1
    if split == 0 or split > 1024 or size != split + 34 or incoming[size - 1] != '\n':
        error(invalid, "expected password line then session-token line and EOF")
    let token = incoming[split + 1..<size - 1]
    if not token_valid(token): error(invalid, "invalid session token")
    var payload: u8[256]
    defer crypto.wipe(payload)
    let wire = try format(payload, f"LUC1\n{origin}\n{account}\n{(str)token}\n")
    try vault.create(path, incoming[..<split], wire.bytes)
    try io.stdout().write("Stored encrypted registry credential.\n")
    return 0

pub func create_repository(origin: str, name: str, path: str) -> i32!:
    if not origin_valid(origin) or path.length == 0 or name.length == 0 or name.length > 64:
        error(invalid, "invalid repository origin, name or vault path")
    for i in 0..<name.length:
        let byte = name.bytes[i]
        let alnum = (byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9')
        if not alnum and (i == 0 or (byte != '_' and byte != '-')):
            error(invalid, "invalid repository name")
    var token = try load(path, origin)
    defer token.close()
    var bearer_buffer: u8[48]
    defer crypto.wipe(bearer_buffer)
    let bearer = try format(bearer_buffer, f"Bearer {(str)try token.bytes()}")
    var body: u8[96]
    let payload = try format(body, f"{{\"name\":\"{name}\"}}")
    var response: u8[128]
    let result = try registry.request(origin, "POST", "/v1/repositories", bearer,
        "application/json", payload.bytes, response)
    if result.status != 201: error(invalid, "repository creation not confirmed; check remote state before retrying")
    if (str)response[..<result.count] != "created": error(invalid, "unexpected response; repository may exist")
    try io.stdout().write("Created remote repository.\n")
    return 0

## Return a separate owning token only after validating exact origin and framing.
pub func load(path: str, origin: str, account: str = "") -> crypto.Secret!:
    if not origin_valid(origin): error(invalid, "invalid credential origin")
    var incoming: u8[1026]
    defer crypto.wipe(incoming)
    let size = try input(incoming)
    if size < 2 or size > 1025 or incoming[size - 1] != '\n': error(invalid, "expected password line and EOF")
    for i in 0..<size - 1:
        if incoming[i] == '\n': error(invalid, "unexpected additional password line")
    var plaintext = try vault.open(path, incoming[..<size - 1])
    defer plaintext.close()
    return try decode_token(try plaintext.bytes(), origin, account)

## Mint a short-lived repository credential from an already-unlocked session.
## The returned raw credential is owning and must be closed by the caller.
pub func issue_credential(session: const u8[], origin: str, repository: str,
                          scope: str, lifetime_seconds: i64 = 300) -> crypto.Secret!:
    if not origin_valid(origin) or not token_valid(session) or not repository_valid(repository) or not scope_valid(scope) or lifetime_seconds < 60 or lifetime_seconds > 7776000:
        error(invalid, "invalid scoped credential request")
    var bearer_buffer: u8[48]
    defer crypto.wipe(bearer_buffer)
    let bearer = try format(bearer_buffer, f"Bearer {(str)session}")
    var body: u8[256]
    defer crypto.wipe(body)
    let payload = try format(body, f"{{\"scope\":\"{scope}\",\"repository\":\"{repository}\",\"lifetime_seconds\":{lifetime_seconds}}}")
    var response: u8[128]
    defer crypto.wipe(response)
    let result = try registry.request(origin, "POST", "/v1/credentials", bearer,
        "application/json", payload.bytes, response)
    if result.status != 201 or not credential_token_valid(response[..<result.count]):
        error(invalid, "registry credential issuance failed")
    return try crypto.secret_from_bytes(response[..<result.count])

## Revoke one raw repository credential with the owning interactive session.
pub func revoke_credential(session: const u8[], origin: str, credential: const u8[]) -> !:
    if not origin_valid(origin) or not token_valid(session) or not credential_token_valid(credential):
        error(invalid, "invalid scoped credential revocation")
    var bearer_buffer: u8[48]
    defer crypto.wipe(bearer_buffer)
    let bearer = try format(bearer_buffer, f"Bearer {(str)session}")
    var body: u8[96]
    defer crypto.wipe(body)
    let payload = try format(body, f"{{\"token\":\"{(str)credential}\"}}")
    var response: u8[128]
    defer crypto.wipe(response)
    let result = try registry.request(origin, "POST", "/v1/credentials/revoke", bearer,
        "application/json", payload.bytes, response)
    if result.status != 200 or (str)response[..<result.count] != "revoked":
        error(invalid, "registry credential revocation failed")

pub func revoke_quiet(session: const u8[], origin: str, credential: const u8[]):
    discard(revoke_credential(session, origin, credential) catch: recover ())

## Canonical HTTP Basic authorization for stock Git-compatible endpoints.
pub func basic_authorization(account: str, credential: const u8[], output: u8[]) -> str!:
    if not name_valid(account) or not credential_token_valid(credential):
        error(invalid, "invalid Git credential")
    var raw: u8[97]
    defer crypto.wipe(raw)
    let value = try format(raw, f"{account}:{(str)credential}")
    let encoded_size = ((value.length + 2) // 3) * 4
    if output.length < 6 + encoded_size: error(invalid, "Git authorization buffer is too small")
    output[0] = 'B'
    output[1] = 'a'
    output[2] = 's'
    output[3] = 'i'
    output[4] = 'c'
    output[5] = ' '
    let alphabet = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var at: usize = 0
    var used: usize = 6
    while at < value.length:
        let remaining = value.length - at
        let a = value.bytes[at]
        let b: u8 = value.bytes[at + 1] if remaining > 1 else 0
        let d: u8 = value.bytes[at + 2] if remaining > 2 else 0
        output[used] = alphabet[(usize)(a >> 2)]
        output[used + 1] = alphabet[(usize)(((a & 3) << 4) | (b >> 4))]
        output[used + 2] = alphabet[(usize)(((b & 15) << 2) | (d >> 6))] if remaining > 1 else '='
        output[used + 3] = alphabet[(usize)(d & 63)] if remaining > 2 else '='
        at += 3
        used += 4
    return (str)output[..<used]

func decode_token(wire: const u8[], origin: str, account: str = "") -> crypto.Secret!:
    var prefix_buffer: u8[64]
    let prefix = try format(prefix_buffer, f"LUC1\n{origin}\n")
    if wire.length < prefix.length + 35 or not strings.starts_with((str)wire, prefix):
        error(invalid, "credential origin mismatch or invalid format")
    var split = prefix.length
    while split < wire.length and wire[split] != '\n': split += 1
    if not name_valid((str)wire[prefix.length..<split]) or wire.length != split + 34 or wire[wire.length - 1] != '\n':
        error(invalid, "invalid credential account or framing")
    if account.length != 0 and (str)wire[prefix.length..<split] != account:
        error(invalid, "credential account mismatch")
    let token = wire[split + 1..<wire.length - 1]
    if not token_valid(token): error(invalid, "invalid stored session token")
    return try crypto.secret_from_bytes(token)

## Unlock an owning seed only after exact local origin/account validation.
pub func signing_seed(path: str, origin: str, account: str) -> crypto.Secret!:
    if not origin_valid(origin) or not name_valid(account) or path.length == 0:
        error(invalid, "invalid signing-key context")
    var incoming: u8[1026]
    defer crypto.wipe(incoming)
    let size = try input(incoming)
    if size < 2 or size > 1025 or incoming[size - 1] != '\n': error(invalid, "expected password line and EOF")
    for i in 0..<size - 1:
        if incoming[i] == '\n': error(invalid, "unexpected additional password line")
    var secret = try vault.open(path, incoming[..<size - 1])
    defer secret.close()
    let wire = try secret.bytes()
    var buffer: u8[128]
    let prefix = try format(buffer, f"LUK1\n{origin}\n{account}\n")
    if wire.length != prefix.length + 32 or not strings.starts_with((str)wire, prefix):
        error(invalid, "signing key origin/account mismatch or invalid format")
    return try crypto.secret_from_bytes(wire[prefix.length..])

## Offline, no-clobber seed custody. Enrollment is a separate explicit command.
pub func key_create(origin: str, account: str, path: str) -> i32!:
    if not origin_valid(origin) or not name_valid(account) or path.length == 0:
        error(invalid, "invalid key origin, account or vault path")
    var incoming: u8[1026]
    defer crypto.wipe(incoming)
    let size = try input(incoming)
    if size < 2 or size > 1025 or incoming[size - 1] != '\n': error(invalid, "expected password line and EOF")
    for i in 0..<size - 1:
        if incoming[i] == '\n': error(invalid, "unexpected additional password line")
    var seed = try keys.generate()
    defer seed.close()
    var payload: u8[256]
    defer crypto.wipe(payload)
    let prefix = try format(payload, f"LUK1\n{origin}\n{account}\n")
    let bytes = try seed.bytes()
    for i in 0..<bytes.length: payload[prefix.length + i] = bytes[i]
    try vault.create(path, incoming[..<size - 1], payload[..<prefix.length + 32])
    try io.stdout().write("Created encrypted signing-key vault; keep a secure backup before enrollment.\n")
    return 0

## Password lines: session-vault password, signing-key-vault password, EOF.
## Never creates/replaces/deletes the key: uncertain network results retain custody.
pub func key_enroll(origin: str, account: str, session_path: str, key_path: str, check_only: bool = false) -> i32!:
    if not origin_valid(origin) or not name_valid(account) or session_path.length == 0 or key_path.length == 0:
        error(invalid, "invalid enrollment origin, account or vault paths")
    var incoming: u8[2051]
    defer crypto.wipe(incoming)
    let size = try input(incoming)
    var split: usize = 0
    while split < size and incoming[split] != '\n': split += 1
    if split == 0 or split > 1024 or size < split + 3 or size - split - 2 > 1024 or incoming[size - 1] != '\n':
        error(invalid, "expected two nonempty password lines and EOF")
    for i in split + 1..<size - 1:
        if incoming[i] == '\n': error(invalid, "unexpected additional password line")
    var session = try vault.open(session_path, incoming[..<split])
    defer session.close()
    var token = try decode_token(try session.bytes(), origin, account)
    defer token.close()
    var secret = try vault.open(key_path, incoming[split + 1..<size - 1])
    defer secret.close()
    let wire = try secret.bytes()
    var prefix_buffer: u8[128]
    let prefix = try format(prefix_buffer, f"LUK1\n{origin}\n{account}\n")
    if wire.length != prefix.length + 32 or not strings.starts_with((str)wire[..<prefix.length], prefix):
        error(invalid, "signing key origin/account mismatch or invalid format")
    let seed = wire[prefix.length..]
    var bearer_buffer: u8[48]
    defer crypto.wipe(bearer_buffer)
    let bearer = try format(bearer_buffer, f"Bearer {(str)try token.bytes()}")
    var response: u8[1953]
    let identity = try registry.request(origin, "GET", "/v1/identity", bearer, "", b"", response)
    if identity.status != 200 or (str)response[..<identity.count] != account:
        error(invalid, "registry session principal mismatch")
    var proof: u8[5261]
    try keys.public_key(seed, proof[..<1952])
    if try key_matches(origin, bearer, proof[..<1952], response):
        try io.stdout().write("Confirmed registry signing key matches the encrypted local vault.\n")
        return 0
    if check_only: error(invalid, "account has no enrolled signing key")
    let challenge = try registry.request(origin, "POST", "/v1/identity/key-challenge", bearer, "", b"", response)
    if challenge.status != 200 or challenge.count != 32: error(invalid, "key challenge unavailable; retain signing-key vault")
    try keys.prove(seed, origin, account, response[..<32], proof[1952..])
    let enrolled = registry.request(origin, "POST", "/v1/identity/key", bearer,
        "application/octet-stream", proof, response) catch:
        error(invalid, "enrollment response lost; retain signing-key vault and reconcile remote state")
    if enrolled.status != 201 or (str)response[..<enrolled.count] != "enrolled":
        error(invalid, "enrollment not confirmed; retain signing-key vault and reconcile remote state")
    if not try key_matches(origin, bearer, proof[..<1952], response):
        error(invalid, "enrollment readback absent; retain signing-key vault and reconcile remote state")
    try io.stdout().write("Enrolled account signing key. Keep the encrypted signing-key vault.\n")
    return 0

func key_matches(origin: str, bearer: str, expected: const u8[], output: u8[]) -> bool!:
    let result = try registry.request(origin, "GET", "/v1/identity/key", bearer, "", b"", output)
    if result.status == 404: return false
    if result.status != 200 or result.count != 1952: error(invalid, "signing key readback unavailable; retain signing-key vault")
    if not crypto.equal(expected, output[..<result.count]): error(invalid, "remote signing key differs; retain signing-key vault")
    return true
