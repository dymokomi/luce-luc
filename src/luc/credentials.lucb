## Encrypted origin-bound session credentials; explicit non-terminal stdin only.
import credential_files as vault
import crypto_native as crypto
import io
import strings
import platform

let invalid: ErrorCode = ErrorCode.package(5)
extern func isatty(descriptor: i32) -> i32

func origin_valid(origin: str) -> bool:
    # Remote networking is still loopback-only; public HTTPS remains pending.
    let prefix = "http://127.0.0.1:"
    if not strings.starts_with(origin, prefix): return false
    let port = (str)origin.bytes[prefix.length..]
    if port.length == 0 or port.length > 5 or port.bytes[0] == '0': return false
    var value: usize = 0
    for byte in port.bytes:
        if byte < '0' or byte > '9': return false
        value = value * 10 + (usize)(byte - '0')
    return value > 0 and value <= 65535

func name_valid(name: str) -> bool:
    if name.length == 0 or name.length > 32: return false
    for byte in name.bytes:
        if not ((byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9') or byte == '_'): return false
    return true

func token_valid(token: const u8[]) -> bool:
    if token.length != 32: return false
    for byte in token:
        if not ((byte >= 'a' and byte <= 'f') or (byte >= '0' and byte <= '9')): return false
    return true

func input(buffer: u8[]) -> usize!:
    if not (platform.macos or platform.linux): error(invalid, "credential stdin requires POSIX")
    if isatty(0) != 0: error(invalid, "refusing secret input from an echoing terminal; use a private pipe")
    var reader = io.stdin()
    var size: usize = 0
    while size < buffer.length:
        let n = try reader.read(buffer[size..])
        if n == 0: return size
        size += n
    error(invalid, "credential input exceeds bounds")

pub func store(origin: str, account: str, path: str) -> i32!:
    if not origin_valid(origin) or not name_valid(account): error(invalid, "invalid credential origin or account")
    var incoming: u8[1060]
    defer crypto.wipe(incoming)
    let size = try input(incoming)
    var split: usize = 0
    while split < size and incoming[split] != '\n': split += 1
    if split == 0 or split > 1024 or size != split + 34 or incoming[size - 1] != '\n':
        error(invalid, "expected password line then session-token line and EOF")
    let token = incoming[split + 1..<size - 1]
    if not token_valid(token): error(invalid, "invalid session token")
    var payload: u8[256]
    defer crypto.wipe(payload)
    let wire = try format(payload, f"LUC1\n{origin}\n{account}\n{(str)token}\n")
    try vault.create(path, incoming[..<split], wire.bytes)
    try io.stdout().write("Stored encrypted registry credential.\n")
    return 0

## Return a separate owning token only after validating exact origin and framing.
pub func load(path: str, origin: str) -> crypto.Secret!:
    if not origin_valid(origin): error(invalid, "invalid credential origin")
    var incoming: u8[1026]
    defer crypto.wipe(incoming)
    let size = try input(incoming)
    if size < 2 or size > 1025 or incoming[size - 1] != '\n': error(invalid, "expected password line and EOF")
    for i in 0..<size - 1:
        if incoming[i] == '\n': error(invalid, "unexpected additional password line")
    var plaintext = try vault.open(path, incoming[..<size - 1])
    defer plaintext.close()
    let wire = try plaintext.bytes()
    var prefix_buffer: u8[64]
    let prefix = try format(prefix_buffer, f"LUC1\n{origin}\n")
    if wire.length < prefix.length + 35 or not strings.starts_with((str)wire, prefix):
        error(invalid, "credential origin mismatch or invalid format")
    var split = prefix.length
    while split < wire.length and wire[split] != '\n': split += 1
    if not name_valid((str)wire[prefix.length..<split]) or wire.length != split + 34 or wire[wire.length - 1] != '\n':
        error(invalid, "invalid credential account or framing")
    let token = wire[split + 1..<wire.length - 1]
    if not token_valid(token): error(invalid, "invalid stored session token")
    return try crypto.secret_from_bytes(token)
