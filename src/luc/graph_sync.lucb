## Verify, cache and materialize an exact luc.lock v3 graph as compiler-local paths.
import pkg
import luc.credentials as credentials
import luc.release_download as release_download
import luc.locked_release as locked_release
import luc.checkout as checkout
import crypto_native as crypto
import git
import files
import paths
import strings
import memory
import io
import os
import c

let invalid: ErrorCode = ErrorCode.package(11)
let managed_begin = "# luc managed registry dependencies begin"
let managed_end = "# luc managed registry dependencies end"

struct Assignment:
    var name: str
    var path: str

func trim(value: str) -> str:
    var start: usize
    var end = value.length
    while start < end and (value.bytes[start] == ' ' or value.bytes[start] == '\t' or value.bytes[start] == '\r'):
        start += 1
    while end > start and (value.bytes[end - 1] == ' ' or value.bytes[end - 1] == '\t' or value.bytes[end - 1] == '\r'):
        end -= 1
    return (str)value.bytes[start..<end]

func assignment_key(line: str) -> str:
    let text = trim(line)
    var at: usize
    while at < text.length and text.bytes[at] != '=': at += 1
    return trim((str)text.bytes[..<at]) if at < text.length else ""

func selected(assignments: const Assignment[], count: usize, name: str) -> bool:
    for i in 0..<count:
        if assignments[i].name == name: return true
    return false

func append(output: u8[], used: usize*, value: str) -> !:
    if *used > output.length or value.length > output.length - *used:
        error(invalid, "materialized manifest exceeds limit")
    for i in 0..<value.length: output[*used + i] = value.bytes[i]
    *used += value.length

func emit_assignments(output: u8[], used: usize*, assignments: const Assignment[], count: usize) -> !:
    try append(output, used, managed_begin)
    try append(output, used, "\n")
    for i in 0..<count:
        try append(output, used, assignments[i].name)
        try append(output, used, " = \"")
        try append(output, used, assignments[i].path)
        try append(output, used, "\"\n")
    try append(output, used, managed_end)
    try append(output, used, "\n")

## Replace only luc's marked block and colliding compiler identities. Everything
## else remains line-for-line, except that output is normalized to a final newline.
func render_manifest(input: const u8[], assignments: const Assignment[], count: usize) -> u8[]!:
    if count > assignments.length or count > 128: error(invalid, "manifest dependency count exceeds limit")
    let scratch = try alloc u8[1310720] in memory.heap
    defer free(scratch) in memory.heap
    var used: usize
    var section = ""
    var found = false
    var skipping = false
    var start: usize
    for end in 0..<input.length + 1:
        if end != input.length and input[end] != '\n': continue
        if end == input.length and start == input.length: continue
        let raw = (str)input[start..<end]
        let line = trim(raw)
        start = end + 1
        if strings.starts_with(line, "["):
            if skipping: error(invalid, "unterminated managed dependency block")
            section = line
            if section == "[dependencies]":
                if found: error(invalid, "duplicate dependencies section")
                found = true
                try append(scratch, &used, raw)
                try append(scratch, &used, "\n")
                try emit_assignments(scratch, &used, assignments, count)
                continue
        if section == "[dependencies]":
            if line == managed_begin:
                if skipping: error(invalid, "nested managed dependency block")
                skipping = true
                continue
            if skipping:
                if line == managed_end: skipping = false
                continue
            if selected(assignments, count, assignment_key(line)): continue
        try append(scratch, &used, raw)
        try append(scratch, &used, "\n")
    if skipping: error(invalid, "unterminated managed dependency block")
    if not found:
        try append(scratch, &used, "\n[dependencies]\n")
        try emit_assignments(scratch, &used, assignments, count)
    let result = try alloc u8[used] in memory.heap
    for i in 0..<used: result[i] = scratch[i]
    return result

func lock_package(lock: pkg.Lock*, coordinate: str) -> usize!:
    for i in 0..<lock.count:
        if lock.packages[i].name == coordinate: return i
    error(invalid, "manifest root is absent from luc.lock")

func same_version(left: pkg.Version, right: pkg.Version) -> bool:
    return left.major == right.major and left.minor == right.minor and left.patch == right.patch

func satisfies(package: pkg.Package, requirement: str) -> bool!:
    if requirement.length == 0: error(invalid, "empty root dependency requirement")
    if requirement.bytes[0] == '^':
        var text: u8[64]
        let version = try format(text, f"{package.version.major}.{package.version.minor}.{package.version.patch}")
        var candidate: pkg.Candidate[1]
        candidate[0] = pkg.Candidate(name = package.name, version = version)
        discard(pkg.select_caret(package.name, (str)requirement.bytes[1..], candidate, 1) catch: return false)
        return true
    return same_version(package.version, try pkg.parse_version(requirement))

func visit(lock: pkg.Lock*, index: usize, marks: u8[]) -> !:
    if marks[index] != 0: return
    marks[index] = 1
    for dependency in lock.packages[index].dependencies:
        try visit(lock, try lock_package(lock, dependency.package), marks)

func validate_roots(lock: pkg.Lock*, declaration: pkg.Manifest*) -> !:
    if lock.schema_version != 3: error(invalid, "sync requires graph-complete luc.lock v3")
    var marks: u8[256]
    for i in 0..<declaration.dependency_count:
        let root = try declaration.dependency_at(i)
        let index = try lock_package(lock, root.package)
        if not try satisfies(lock.packages[index], root.requirement):
            error(invalid, "luc.lock does not satisfy a manifest root requirement")
        try visit(lock, index, marks)
    for i in 0..<lock.count:
        if marks[i] == 0: error(invalid, "luc.lock contains a package unreachable from the manifest roots")

func strict_directory(path: str, permissions: u32) -> !:
    let name = try strings.copy(path)
    defer strings.release(name)
    let info = files.metadata((c.str)name, follow_symlinks = false) catch failure:
        if failure.code != files.missing: error(failure.code, failure.message)
        files.create_directory((c.str)name, permissions) catch create_failure:
            if create_failure.code != files.already_exists: error(create_failure.code, create_failure.message)
        recover try files.metadata((c.str)name, follow_symlinks = false)
    if info.kind != files.FileKind.directory: error(invalid, "package state path is not a directory")

func encode_hex(bytes: const u8[], output: u8[]) -> str!:
    if bytes.length * 2 > output.length: error(invalid, "digest output too small")
    let digits = b"0123456789abcdef"
    for i in 0..<bytes.length:
        output[i * 2] = digits[bytes[i] >> 4]
        output[i * 2 + 1] = digits[bytes[i] & 15]
    return (str)output[..<bytes.length * 2]

func artifact_identity(origin: str, package: str, version: str, output: u8[]) -> str!:
    var input: u8[512]
    let value = try format(input, f"{origin}\n{package}\n{version}")
    var digest: u8[32]
    discard(try crypto.digest(value.bytes, digest, "sha256"))
    return try encode_hex(digest, output)

func artifact_path(cache: str, origin: str, package: pkg.Package) -> str!:
    var version_buffer: u8[64]
    let version = try format(version_buffer, f"{package.version.major}.{package.version.minor}.{package.version.patch}")
    var identity_buffer: u8[64]
    let identity = try artifact_identity(origin, package.name, version, identity_buffer)
    var name_buffer: u8[96]
    return try paths.join(cache, try format(name_buffer, f"release-{identity}.lrp1"))

func close_unverified(download: release_download.Download*, verified: bool*):
    if not *verified: download.close()

func fetch_package(cache: str, origin: str, package: pkg.Package, lock: pkg.Lock*, key: const u8[],
                   token: const u8[], online: bool) -> release_download.Download!:
    var version_buffer: u8[64]
    let version = try format(version_buffer, f"{package.version.major}.{package.version.minor}.{package.version.patch}")
    let artifact = try artifact_path(cache, origin, package)
    defer strings.release(artifact)
    var downloaded: release_download.Download
    if online:
        downloaded = try release_download.fetch_session_authenticated(origin, package.name, version, key, token)
        var verified = false
        errdefer close_unverified(&downloaded, &verified)
        let release = try pkg.decode_release(downloaded.metadata[..<downloaded.metadata_size])
        discard(try locked_release.require(lock, release, downloaded.publisher_key_digest))
        if files.exists((c.str)artifact):
            var cached = try release_download.load_cache_authenticated(artifact, origin, package.name, version, key)
            defer cached.close()
            if not release_download.same(&downloaded, &cached): error(invalid, "cached release differs from immutable registry release")
        else:
            release_download.save_cache(&downloaded, artifact) catch failure:
                if failure.code != files.already_exists: error(failure.code, failure.message)
                var raced = try release_download.load_cache_authenticated(artifact, origin, package.name, version, key)
                defer raced.close()
                if not release_download.same(&downloaded, &raced): error(invalid, "concurrent cache publication differs from registry release")
        verified = true
        return downloaded
    downloaded = try release_download.load_cache_authenticated(artifact, origin, package.name, version, key)
    var verified = false
    errdefer close_unverified(&downloaded, &verified)
    let release = try pkg.decode_release(downloaded.metadata[..<downloaded.metadata_size])
    discard(try locked_release.require(lock, release, downloaded.publisher_key_digest))
    verified = true
    return downloaded

func release_assignments(values: Assignment[], count: usize):
    for i in 0..<count: strings.release(values[i].path)

func wire_package(lock: pkg.Lock*, index: usize, directory: str, release: pkg.Release) -> !:
    let manifest_path = try strings.copy(try paths.join(directory, "luce.toml"))
    defer strings.release(manifest_path)
    let original = try files.read_limit((c.str)manifest_path, 1048576)
    defer free(original) in memory.heap
    try pkg.validate_release_manifest(release, (str)original)
    var assignments: Assignment[128]
    var count: usize
    defer release_assignments(assignments, count)
    for dependency in lock.packages[index].dependencies:
        let target = lock.packages[try lock_package(lock, dependency.package)]
        var path_buffer: u8[256]
        assignments[count] = Assignment(name = target.package_name,
            path = try strings.copy(try format(path_buffer, f"../{target.package_name}")))
        count += 1
    let rendered = try render_manifest(original, assignments, count)
    defer free(rendered) in memory.heap
    try files.write((c.str)manifest_path, rendered)

func materialize_package(lock: pkg.Lock*, index: usize, generation: str,
                         downloaded: release_download.Download*) -> !:
    let release = try pkg.decode_release(downloaded.metadata[..<downloaded.metadata_size])
    var commit: u8[20]
    try git.decode_id(release.commit, commit)
    var pack = try git.decode_pack(downloaded.source[..<downloaded.source_size])
    defer pack.close()
    let destination = try strings.copy(try paths.join(generation, lock.packages[index].package_name))
    defer strings.release(destination)
    try checkout.materialize(&pack, commit, destination)
    try wire_package(lock, index, destination, release)

func materialize_one(cache: str, lock: pkg.Lock*, index: usize, key: const u8[], token: const u8[],
                     online: bool, generation: str) -> !:
    var downloaded = try fetch_package(cache, lock.origin, lock.packages[index], lock, key, token, online)
    defer downloaded.close()
    try materialize_package(lock, index, generation, &downloaded)

func entry_exists(path: str) -> files.Metadata?!:
    let value = files.metadata((c.str)path, follow_symlinks = false) catch failure:
        if failure.code == files.missing: return none
        error(failure.code, failure.message)
    return value

func publish_generation(stage: files.TemporaryDirectory*, destination: str, parent: str) -> !:
    if let info = try entry_exists(destination):
        if info.kind != files.FileKind.directory: error(invalid, "package generation destination is not a directory")
        var backup_owner = try files.TemporaryDirectory((c.str)parent)
        let backup = try strings.copy(backup_owner.path())
        defer strings.release(backup)
        # TemporaryDirectory.close currently trips UBSan while enumerating an
        # empty directory; remove the known-empty entry, then release its owner.
        try files.remove_directory((c.str)backup)
        backup_owner.destroy()
        try files.rename((c.str)destination, (c.str)backup, replace = false)
        files.rename((c.str)stage.path(), (c.str)destination, replace = false) catch failure:
            files.rename((c.str)backup, (c.str)destination, replace = false) catch rollback:
                error(rollback.code, "package generation publication and rollback both failed")
            error(failure.code, failure.message)
        try files.remove_tree((c.str)backup)
    else:
        try files.rename((c.str)stage.path(), (c.str)destination, replace = false)
    var parent_file = try files.File.open((c.str)parent)
    defer parent_file.destroy()
    try parent_file.sync()
    try parent_file.close()

func publish_manifest(path: str, original: const u8[], rendered: const u8[]) -> !:
    let current = try files.read_limit((c.str)path, 1048576)
    defer free(current) in memory.heap
    if not crypto.equal(current, original): error(invalid, "luce.toml changed while packages were being synchronized")
    let parent = try strings.copy(paths.directory(path))
    defer strings.release(parent)
    var parent_file = try files.File.open((c.str)parent)
    defer parent_file.destroy()
    var temporary = try files.TemporaryFile.create((c.str)parent, permissions = 420)
    defer temporary.destroy()
    try io.write_all(&temporary, rendered)
    try temporary.sync()
    try temporary.publish((c.str)path, replace = true)
    try parent_file.sync()
    try parent_file.close()

func root_manifest(lock: pkg.Lock*, declaration: pkg.Manifest*, original: const u8[], generation: str) -> u8[]!:
    var assignments: Assignment[128]
    var count: usize
    defer release_assignments(assignments, count)
    for i in 0..<declaration.dependency_count:
        let root = try declaration.dependency_at(i)
        let target = lock.packages[try lock_package(lock, root.package)]
        var path_buffer: u8[384]
        assignments[count] = Assignment(name = target.package_name,
            path = try strings.copy(try format(path_buffer, f".luc/packages/{generation}/{target.package_name}")))
        count += 1
    return try render_manifest(original, assignments, count)

func execute(root: str, manifest_path: str, manifest_bytes: const u8[], declaration: pkg.Manifest*,
             lock_bytes: const u8[], lock: pkg.Lock*, key: const u8[], token: const u8[], online: bool) -> i32!:
    try validate_roots(lock, declaration)
    let state = try strings.copy(try paths.join(root, ".luc"))
    defer strings.release(state)
    try strict_directory(state, 448)
    let packages = try strings.copy(try paths.join(state, "packages"))
    defer strings.release(packages)
    try strict_directory(packages, 448)
    let default_cache = try strings.copy(try paths.join(state, "cache"))
    defer strings.release(default_cache)
    let cache = try strings.copy(os.env((c.str)"LUC_PACKAGE_CACHE") else default_cache)
    defer strings.release(cache)
    if cache.length == 0: error(invalid, "LUC_PACKAGE_CACHE must not be empty")
    try strict_directory(cache, 448)
    var lock_digest: u8[32]
    discard(try crypto.digest(lock_bytes, lock_digest, "sha256"))
    var lock_hex_buffer: u8[64]
    let lock_hex = try encode_hex(lock_digest, lock_hex_buffer)
    var generation_buffer: u8[70]
    let generation = try format(generation_buffer, f"graph-{lock_hex}")
    var stage = try files.TemporaryDirectory((c.str)packages)
    defer stage.destroy()
    # Keep failure-path cleanup out of Base's current empty remove_tree UBSan bug.
    let marker = try strings.copy(try paths.join(stage.path(), ".luc-generation"))
    defer strings.release(marker)
    try files.write((c.str)marker, lock_hex.bytes)
    for i in 0..<lock.count:
        try materialize_one(cache, lock, i, key, token, online, stage.path())
    let destination = try strings.copy(try paths.join(packages, generation))
    defer strings.release(destination)
    try publish_generation(&stage, destination, packages)
    let rendered = try root_manifest(lock, declaration, manifest_bytes, generation)
    defer free(rendered) in memory.heap
    try publish_manifest(manifest_path, manifest_bytes, rendered)
    let mode = "registry and verified cache" if online else "verified offline cache"
    try io.stdout().write(f"synchronized {lock.count} locked packages from {mode}\n")
    return 0

pub func run(root: str, manifest_path: str, key_path: str, vault_path: str = "", offline: bool = false) -> i32!:
    let manifest_name = try strings.copy(manifest_path)
    defer strings.release(manifest_name)
    let manifest_bytes = try files.read_limit((c.str)manifest_name, 1048576)
    defer free(manifest_bytes) in memory.heap
    var declaration = try pkg.decode_manifest((str)manifest_bytes)
    defer declaration.close()
    let lock_path = try strings.copy(try paths.join(root, "luc.lock"))
    defer strings.release(lock_path)
    let lock_bytes = try files.read_limit((c.str)lock_path, 1048576)
    defer free(lock_bytes) in memory.heap
    var lock = try pkg.decode_lock((str)lock_bytes)
    defer lock.close()
    let key = try release_download.trusted_key(key_path)
    defer free(key) in memory.heap
    if offline: return try execute(root, manifest_path, manifest_bytes, &declaration, lock_bytes, &lock, key, b"", false)
    var session = try credentials.load(vault_path, lock.origin)
    defer session.close()
    return try execute(root, manifest_path, manifest_bytes, &declaration, lock_bytes, &lock, key, try session.bytes(), true)
