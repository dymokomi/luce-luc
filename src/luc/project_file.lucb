## package.prisma is the authored project file. The luce.toml the compilers read is
## generated from it at the project root and is never edited by hand.
import c
import files
import memory
import paths
import strings
import pkg
import prism

pub let file_name = "package.prisma"
pub let generated_name = "luce.toml"
pub let invalid = pkg.invalid
let header = "# Generated by luc from package.prisma. Do not edit; changes are overwritten.\n"
let max_generated: usize = 131072
let max_depth: usize = 32

pub func exists_in(directory: str) -> bool!:
    let path = try paths.join(directory, file_name)
    defer strings.release(path)
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    return files.exists((c.str)terminated)

## Decoded package.prisma of `directory`; the caller closes it.
pub func read(directory: str) -> pkg.Definition!:
    let path = try paths.join(directory, file_name)
    defer strings.release(path)
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    let bytes = try files.read((c.str)terminated)
    defer free(bytes) in memory.heap
    return try pkg.decode_package(bytes)

struct Output:
    var bytes: u8[]
    var used: usize

    mutating func put(text: str) -> !:
        if self.used + text.length > self.bytes.length: error(invalid, "generated luce.toml is too large")
        for i in 0..<text.length: self.bytes[self.used + i] = text.bytes[i]
        self.used += text.length

    ## `key = ["a", "b"]`, or nothing for an empty list.
    mutating func array(key: str, values: const str[]) -> !:
        if values.length == 0: return
        try self.put(key)
        try self.put(" = [")
        for i in 0..<values.length:
            for byte in values[i].bytes:
                if byte == '"' or byte == '\\' or byte < 0x20: error(invalid, "value cannot be written to luce.toml")
            if i > 0: try self.put(", ")
            try self.put("\"")
            try self.put(values[i])
            try self.put("\"")
        try self.put("]\n")

    mutating func pair(key: str, value: str) -> !:
        for byte in value.bytes:
            if byte == '"' or byte == '\\' or byte < 0x20: error(invalid, "value cannot be written to luce.toml")
        try self.put(key)
        try self.put(" = \"")
        try self.put(value)
        try self.put("\"\n")

## Where `luc sync` unpacks a locked registry package inside the project at `root`.
pub func dependency_directory(root: str, name: str) -> str!:
    let hidden = try paths.join(root, ".luc")
    defer strings.release(hidden)
    let parent = try paths.join(hidden, "deps")
    defer strings.release(parent)
    return try paths.join(parent, name)

## `registry` marks a package that came from the registry: its own `path` overrides
## are its author's and are ignored, so every dependency resolves under `root`.
func render(definition: pkg.Definition*, output: Output*, root: str, registry: bool) -> !:
    try output.put(header)
    try output.put("[package]\n")
    # The compilers want identifiers: luce-json is package and dependency key luce_json.
    let identifier = try module_name(definition.name)
    defer strings.release(identifier)
    try output.pair("name", identifier)
    try output.pair("language", definition.language)
    try output.pair("source", definition.source)
    if definition.export_count > 0:
        try output.put("\n[exports]\n")
        for i in 0..<definition.export_count:
            let item = try definition.export_at(i)
            try output.pair(item.name, item.module)
    let native = &definition.native
    if native.source_count + native.link_search_count + native.library_count + native.framework_count + native.pkg_config_count > 0:
        try output.put("\n[native]\n")
        try output.array("sources", native.sources[..<native.source_count])
        try output.array("link_search", native.link_search[..<native.link_search_count])
        try output.array("libraries", native.libraries[..<native.library_count])
        try output.array("frameworks", native.frameworks[..<native.framework_count])
        try output.array("pkg_config", native.pkg_config[..<native.pkg_config_count])
    var opened = false
    for i in 0..<definition.dependency_count:
        let item = try definition.dependency_at(i)
        if not opened: try output.put("\n[dependencies]\n")
        opened = true
        let key = try module_name(item.name)
        defer strings.release(key)
        if item.path.length > 0 and not registry:
            try output.pair(key, item.path)
            continue
        let location = try dependency_directory(root, item.name)
        defer strings.release(location)
        try output.pair(key, location)

func same(path: c.str, content: const u8[]) -> bool:
    if not files.exists(path): return false
    let current = files.read(path) catch: return false
    defer free(current) in memory.heap
    if current.length != content.length: return false
    for i in 0..<content.length:
        if current[i] != content[i]: return false
    return true

## Write luce.toml for this package and, recursively, for every path dependency that has
## its own package.prisma. Unchanged files are left alone so build caches stay warm.
pub func generate(directory: str, root: str, registry: bool = false, depth: usize = 0) -> !:
    if depth > max_depth: error(invalid, "path dependencies nest too deeply or form a cycle")
    var definition = try read(directory)
    defer definition.close()
    let buffer = try alloc u8[max_generated] in memory.heap
    defer free(buffer) in memory.heap
    var output = Output(bytes = buffer)
    try render(&definition, &output, root, registry)
    let target = try paths.join(directory, generated_name)
    defer strings.release(target)
    let terminated = try strings.copy(target)
    defer strings.release(terminated)
    if not same((c.str)terminated, buffer[..<output.used]):
        try files.write((c.str)terminated, buffer[..<output.used])
    for i in 0..<definition.dependency_count:
        let item = try definition.dependency_at(i)
        let on_disk = item.path.length > 0 and not registry
        let location = try paths.join(directory, item.path) if on_disk else try dependency_directory(root, item.name)
        defer strings.release(location)
        if try exists_in(location): try generate(location, root, not on_disk, depth + 1)

func save(document: prism.Document*, directory: str) -> !:
    let encoded = try document.encode(prism.Encoding.text)
    defer encoded.release()
    discard(try pkg.decode_package(encoded.value().bytes()))
    let path = try paths.join(directory, file_name)
    defer strings.release(path)
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    try files.write((c.str)terminated, encoded.value().bytes())

func set_text(document: prism.Document*, path: str, name: str, text: str) -> !:
    let value = try prism.Value.text(text)
    defer value.release()
    try document.set(path, name, value)

func element(root: str, name: str, output: u8[]) -> str!:
    return try format(output, f"/{root}/{name}")

## Add or replace a dependency on the package checked out at `location`.
pub func add_dependency(directory: str, location: str) -> str!:
    let source = try paths.join(directory, location)
    defer strings.release(source)
    if not try exists_in(source): error(invalid, "no package.prisma at that path")
    var dependency = try read(source)
    defer dependency.close()
    var current = try read(directory)
    defer current.close()
    let file = try paths.join(directory, file_name)
    defer strings.release(file)
    let reference = try prism.Document.load(file)
    defer reference.release()
    let document = reference.value()
    var buffer: u8[256]
    let path = try element(current.name, dependency.name, buffer)
    if document.contains(path): try document.remove(path)
    try document.add(path, "dependency")
    try set_text(document, path, "owner", dependency.owner)
    var requirement: u8[80]
    try set_text(document, path, "version", try format(requirement, f"^{dependency.version}"))
    try set_text(document, path, "path", location)
    try save(document, directory)
    return try strings.copy(dependency.name)

## Add or replace a dependency on a released registry package.
pub func add_registry_dependency(directory: str, owner: str, name: str, requirement: str) -> !:
    var current = try read(directory)
    defer current.close()
    let file = try paths.join(directory, file_name)
    defer strings.release(file)
    let reference = try prism.Document.load(file)
    defer reference.release()
    let document = reference.value()
    var buffer: u8[256]
    let path = try element(current.name, name, buffer)
    if document.contains(path): try document.remove(path)
    try document.add(path, "dependency")
    try set_text(document, path, "owner", owner)
    try set_text(document, path, "version", requirement)
    try save(document, directory)

pub func remove_dependency(directory: str, name: str) -> bool!:
    var current = try read(directory)
    defer current.close()
    let file = try paths.join(directory, file_name)
    defer strings.release(file)
    let reference = try prism.Document.load(file)
    defer reference.release()
    let document = reference.value()
    var buffer: u8[256]
    let path = try element(current.name, name, buffer)
    if not document.contains(path) or try document.type_at(path) != "dependency": return false
    try document.remove(path)
    try save(document, directory)
    return true

## Module identifier for a package name: hyphens become underscores.
pub func module_name(name: str) -> str!:
    let copy = try strings.copy(name)
    let bytes = (u8[])copy.bytes
    for i in 0..<bytes.length:
        if bytes[i] == '-': bytes[i] = '_'
    return copy

## Text of a new package.prisma for `luc init` and `luc new`.
pub func scaffold(name: str, owner: str, language: str, is_package: bool, output: u8[]) -> str!:
    let suffix = ".luc" if language == "luce" else ".lucb"
    if is_package:
        let module = try module_name(name)
        defer strings.release(module)
        return try format(output, f"#prisma 4.0\ndef package \"{name}\" {{\n    str owner = \"{owner}\"\n    str version = \"0.1.0\"\n    str language = \"{language}\"\n    def export \"{module}\" {{\n        str module = \"{module}.{module}\"\n    }}\n}}\n")
    return try format(output, f"#prisma 4.0\ndef package \"{name}\" {{\n    str owner = \"{owner}\"\n    str version = \"0.1.0\"\n    str language = \"{language}\"\n    str entry = \"src/main{suffix}\"\n}}\n")
