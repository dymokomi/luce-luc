## Offline signed LRP1 artifact creation. No implicit network or overwrite.
import pkg
import git
import crypto_native as crypto
import luc.credentials as credentials
import luc.pack_check as pack_check
import luc.registry_http as registry
import files
import paths
import strings
import memory
import io
import c

let invalid: ErrorCode = ErrorCode.package(6)
let max_artifact: usize = 67108864 + pkg.max_release_metadata + 3309 + 8

struct Artifact:
    var metadata: const u8[]
    var signature: const u8[]
    var source: const u8[]
    var release: pkg.Release
    var account: str
    var name: str

func package_parts(package: str) -> (str, str)!:
    var split: usize = 0
    while split < package.length and package.bytes[split] != '/': split += 1
    if split == 0 or split > 32 or split == package.length: error(invalid, "invalid package identity")
    let account = (str)package.bytes[..<split]
    let name = (str)package.bytes[split + 1..]
    if name.length == 0 or name.length > 64: error(invalid, "invalid package identity")
    for byte in account.bytes:
        if not ((byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9') or byte == '_'):
            error(invalid, "invalid package owner")
    for i in 0..<name.length:
        let byte = name.bytes[i]
        let alnum = (byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9')
        if not alnum and (i == 0 or (byte != '_' and byte != '-')): error(invalid, "invalid package name")
    return (account, name)

func decode_artifact(origin: str, artifact: const u8[]) -> Artifact!:
    if artifact.length < 3367 or (str)artifact[..<4] != "LRP1" or artifact[6] != 0 or artifact[7] != 0:
        error(invalid, "invalid release upload envelope")
    let size = (usize)artifact[4] + ((usize)artifact[5] << 8)
    if size < 50 or size > pkg.max_release_metadata or artifact.length < 8 + size + 3309:
        error(invalid, "invalid release upload lengths")
    let metadata = artifact[8..<8 + size]
    let signature = artifact[8 + size..<3317 + size]
    let source = artifact[3317 + size..]
    if source.length > 67108864: error(invalid, "release source too large")
    let release = try pkg.decode_release(metadata)
    if release.origin != origin: error(invalid, "release origin mismatch")
    discard(try pkg.parse_version(release.toolchain))
    let (account, name) = try package_parts(release.package)
    return Artifact(metadata = metadata, signature = signature, source = source,
        release = release, account = account, name = name)

## Explicit origin prevents an artifact from choosing the credential destination.
## Check-only performs GETs exclusively; upload never retries a POST implicitly.
pub func upload(origin: str, artifact_path: str, vault_path: str, check_only: bool = false) -> i32!:
    let artifact = try read(artifact_path, max_artifact)
    defer free(artifact) in memory.heap
    let decoded = try decode_artifact(origin, artifact)
    var session = try credentials.load(vault_path, origin, decoded.account)
    defer session.close()
    return try upload_session_bytes(origin, artifact, decoded, try session.bytes(), check_only)

## Publish/reconcile one saved artifact with an already-unlocked session.
pub func upload_session(origin: str, artifact_path: str, session: const u8[], check_only: bool = false) -> i32!:
    let artifact = try read(artifact_path, max_artifact)
    defer free(artifact) in memory.heap
    let decoded = try decode_artifact(origin, artifact)
    return try upload_session_bytes(origin, artifact, decoded, session, check_only)

func upload_session_bytes(origin: str, artifact: const u8[], decoded: Artifact,
                          session_bytes: const u8[], check_only: bool) -> i32!:
    # The interactive session reads the enrolled key and mints a bounded
    # publication credential; package endpoints never receive the session.
    var session_bearer_buffer: u8[48]
    defer crypto.wipe(session_bearer_buffer)
    let session_bearer = try format(session_bearer_buffer, f"Bearer {(str)session_bytes}")
    var key: u8[1952]
    let identity = try registry.request(origin, "GET", "/v1/identity/key", session_bearer, "", b"", key)
    if identity.status != 200 or identity.count != key.length: error(invalid, "cannot read enrolled signing key")
    if not try pkg.verify_release(decoded.release, key, decoded.signature, decoded.source):
        error(invalid, "artifact does not verify against enrolled key")
    var requested: u8[20]
    try git.decode_id(decoded.release.commit, requested)
    var pack = try git.decode_pack(decoded.source)
    defer pack.close()
    try pack_check.validate(&pack, requested)
    var token = try credentials.issue_credential(session_bytes, origin, decoded.name, "package:publish")
    defer token.close()
    let token_bytes = try token.bytes()
    defer credentials.revoke_quiet(session_bytes, origin, token_bytes)
    var bearer_buffer: u8[80]
    defer crypto.wipe(bearer_buffer)
    let bearer = try format(bearer_buffer, f"Bearer {(str)token_bytes}")
    var endpoint_buffer: u8[256]
    let endpoint = try format(endpoint_buffer, f"/v1/releases/{decoded.release.package}")
    if not check_only:
        var response: u8[128]
        let result = registry.request(origin, "POST", endpoint, bearer, "application/octet-stream", artifact, response) catch:
            error(invalid, "upload outcome uncertain; retain artifact and use release-check before retrying")
        if not ((result.status == 201 and (str)response[..<result.count] == "published") or (result.status == 200 and (str)response[..<result.count] == "unchanged")):
            error(invalid, "upload not confirmed; retain artifact and use release-check")
    let output = try alloc u8[67108864] in memory.heap
    defer free(output) in memory.heap
    for part in ["metadata", "signature", "source"]:
        var path_buffer: u8[384]
        let path = try format(path_buffer, f"{endpoint}/{decoded.release.version}/{part}")
        let result = try registry.request(origin, "GET", path, bearer, "", b"", output)
        let expected = decoded.metadata if part == "metadata" else (decoded.signature if part == "signature" else decoded.source)
        if result.status != 200 or not crypto.equal(output[..<result.count], expected):
            error(invalid, "release readback not confirmed; retain artifact for reconciliation")
    try io.stdout().write("Confirmed exact signed release bytes in registry.\n")
    return 0

func read(path: str, maximum: usize) -> u8[]!:
    let name = try strings.copy(path)
    defer strings.release(name)
    return try files.read_limit((c.str)name, maximum)

pub func sign(metadata_path: str, source_path: str, destination: str, vault_path: str) -> i32!:
    let metadata = try read(metadata_path, pkg.max_release_metadata)
    defer free(metadata) in memory.heap
    let release = try pkg.decode_release(metadata)
    let (account, _) = try package_parts(release.package)
    let source = try read(source_path, 67108864)
    defer free(source) in memory.heap
    var seed = try credentials.signing_seed(vault_path, release.origin, account)
    defer seed.close()
    return try sign_seed(metadata, source, destination, try seed.bytes())

## Sign exact in-memory LRS metadata/source with an already-unlocked seed and
## durably publish one immutable LRP1 artifact.
pub func sign_seed(metadata: const u8[], source: const u8[], destination: str, seed: const u8[]) -> i32!:
    if destination.length == 0 or destination.length > 4096: error(invalid, "invalid artifact destination")
    for byte in destination.bytes:
        if byte == 0: error(invalid, "invalid artifact destination")
    let basename = paths.base(destination)
    if basename.length == 0 or basename == "." or basename == "..": error(invalid, "invalid artifact filename")
    let filename = try strings.copy(destination)
    defer strings.release(filename)
    var exists = true
    discard(files.metadata((c.str)filename, follow_symlinks = false) catch failure:
        if failure.code != files.missing: error(failure.code, failure.message)
        exists = false
        recover files.Metadata())
    if exists: error(invalid, "artifact destination already exists")
    let release = try pkg.decode_release(metadata)
    discard(try pkg.parse_version(release.toolchain))
    discard(try package_parts(release.package))
    if source.length > 67108864: error(invalid, "release source too large")
    var digest: u8[32]
    discard(try pkg.source_digest(source, digest))
    if not crypto.equal(digest, release.source_digest): error(invalid, "release source digest mismatch")
    var requested: u8[20]
    try git.decode_id(release.commit, requested)
    var pack = try git.decode_pack(source)
    defer pack.close()
    try pack_check.validate(&pack, requested)
    if seed.length != 32: error(invalid, "invalid signing seed")
    var key: u8[1952]
    var secret: u8[4032]
    defer crypto.wipe(secret)
    try crypto.mldsa_keygen(seed, key, secret)
    var randomness = try crypto.random_secret(32)
    defer randomness.close()
    var signature: u8[3309]
    try crypto.mldsa_sign(secret, metadata, try randomness.bytes(), signature)
    if not try pkg.verify_release(release, key, signature, source): error(invalid, "release signature self-check failed")
    let directory = paths.directory(filename)
    let parent_path = try strings.copy(directory if directory.length > 0 else ".")
    defer strings.release(parent_path)
    var parent = try files.Directory.open((c.str)parent_path, follow_symlinks = false)
    defer parent.destroy()
    var parent_file = try files.File.open((c.str)parent_path)
    defer parent_file.destroy()
    var temporary = try files.TemporaryFile.create((c.str)parent_path, permissions = 384)
    defer temporary.destroy()
    var header: u8[8]
    header[0] = 'L'
    header[1] = 'R'
    header[2] = 'P'
    header[3] = '1'
    header[4] = (u8)(metadata.length & 255)
    header[5] = (u8)(metadata.length >> 8)
    try io.write_all(&temporary, header)
    try io.write_all(&temporary, metadata)
    try io.write_all(&temporary, signature)
    try io.write_all(&temporary, source)
    try temporary.sync()
    try temporary.publish((c.str)filename, replace = false)
    try parent_file.sync()
    try parent_file.close()
    try io.stdout().write("Saved signed release upload artifact; retain these exact bytes for publication retries.\n")
    return 0
