#==============================================================================================
#
#   luc - The Luce project tool
#
#   DESCRIPTION:
#       One command for a Luce project: build, run, test, check and format it through the Luce
#       compiler, and run the named workflows in its package.prisma tasks. luc finds the project
#       by walking up to the nearest package.prisma, picks the compiler from the package language
#       (luce-base or luce, overridable with LUCE_BASE / LUCE), and forwards the compiler's own
#       output and exit code. This is the MVP surface; scaffolding, dependencies, task
#       dependency graphs and workspaces follow (see README).
#
#==============================================================================================

import c
import io
import os
import files
import paths
import platform
import process
import strings
import memory
import pkg
import luc.remote as remote
import luc.pack_check as pack_check
import luc.credentials as credentials
import luc.checkout as checkout
import luc.project_file as project_file
import luc.packages as packages
import luc.registry_http as registry_http
import luc.apps as apps
import luc.progress as progress
import luc.release as releasing
import git
import crypto_native

## The luc version, kept in step with package.prisma.
pub let luc_version: str = "0.18.6"

## The only registry account for now; `luc init` writes it as the package owner.
let default_owner = "dymokomi"

## A command-line or manifest problem the user can fix.
pub let usage_error: ErrorCode = ErrorCode.package(1)

# A scratch buffer for one interpolated error message at a time (errors are terminal).
var message_buffer: u8[512]

# mark: The project ===========================================================================

## One `[tasks]` workflow: its name, the shell command it runs, an optional one-line
## description, and the tasks it depends on (run first).
struct Task:
    var name: str
    var command: str
    var description: str
    var depends: str[]

## A loaded project: where it is, the package identity, the chosen entry, and its tasks.
struct Project:
    var root: str
    var name: str
    var language: str
    var entry: str
    var tasks: Task[]
    var task_count: usize

    mutating func close():
        strings.release(self.root)
        strings.release(self.name)
        strings.release(self.language)
        strings.release(self.entry)
        for i in 0..<self.task_count:
            strings.release(self.tasks[i].name)
            strings.release(self.tasks[i].command)
            strings.release(self.tasks[i].description)
            for dependency in self.tasks[i].depends: strings.release(dependency)
            if self.tasks[i].depends.length > 0: free(self.tasks[i].depends) in memory.heap
        if self.tasks.length > 0: free(self.tasks) in memory.heap
        self.task_count = 0

    ## The compiler for this project's language, overridable through the environment.
    func compiler() -> str!:
        let variable = "LUCE" if self.language == "luce" else "LUCE_BASE"
        if let chosen = os.env((c.str)variable):
            return chosen
        return "luce" if self.language == "luce" else "luce-base"

    ## The entry source: the manifest's `entry`, else the conventional app main, else the
    ## package's own library module (src/<name>/<name>.<ext>) so `check` works on a package.
    func entry_path() -> str!:
        if self.entry.length > 0:
            return try paths.join(self.root, self.entry)
        let suffix = ".luc" if self.language == "luce" else ".lucb"
        let main_name = try join_name("main", suffix)
        defer strings.release(main_name)
        let identifier = try project_file.module_name(self.name)
        defer strings.release(identifier)
        let module_name = try join_name(identifier, suffix)
        defer strings.release(module_name)
        let module_directory = try paths.join("src", identifier)
        defer strings.release(module_directory)
        let module = try paths.join(module_directory, module_name)
        defer strings.release(module)
        let application = try paths.join("src", main_name)
        defer strings.release(application)
        for relative in [application, main_name, module]:
            let candidate = try paths.join(self.root, relative)
            let terminated = try strings.copy(candidate)
            let exists = files.exists((c.str)terminated)
            strings.release(terminated)
            if exists: return candidate
            strings.release(candidate)
        error(usage_error, "no entry source found (expected src/main or src/<name>/<name>); set entry in package.prisma")

    func find_task(name: str) -> Task?:
        var index: usize = 0
        while index < self.task_count:
            if self.tasks[index].name == name:
                return self.tasks[index]
            index += 1
        return none

# mark: Loading the project ====================================================================

## Find the nearest package.prisma from the current directory upward, load it, and
## remove any stale luce.toml. Absent one, the project is an anonymous
## luce-base app rooted at the current directory.
## `registry` loads a package that was downloaded from the registry, so every dependency,
## including ones its author overrides with a local path, comes from the registry.
func load_project(prepare: bool = true, directory_hint: str = "", registry: bool = false) -> Project!:
    let start = try strings.copy(directory_hint) if directory_hint.length > 0 else try os.cwd()
    defer strings.release(start)
    var project = Project(root = try strings.copy(start), name = try strings.copy("app"),
        language = try strings.copy("luce-base"), entry = try strings.copy(""))
    errdefer project.close()
    project.tasks = try alloc Task[128]
    var directory = start
    while true:
        if try project_file.exists_in(directory):
            strings.release(project.root)
            project.root = try strings.copy(directory)
            try apply_definition(&project)
            if prepare: try packages.prepare(project.root, registry)
            try project_file.generate(project.root, project.root, registry)
            return project
        let parent = paths.directory(directory)
        if parent == directory or parent.length == 0:
            return project
        directory = parent

func apply_definition(project: Project*) -> !:
    var definition = try project_file.read(project.root)
    defer definition.close()
    try replace_text(&project.name, definition.name)
    try replace_text(&project.language, definition.language)
    try replace_text(&project.entry, definition.entry)
    for i in 0..<definition.task_count:
        let declared = try definition.task_at(i)
        let slot = try task_slot(project, declared.name)
        try replace_text(&project.tasks[slot].command, declared.command)
        try replace_text(&project.tasks[slot].description, declared.description)
        var depends: str[]
        for j in 0..<declared.depend_count:
            depends = try append(depends, try strings.copy(declared.depends[j]))
        project.tasks[slot].depends = depends

## Parse the little of luce.toml luc needs: [package] name/language/entry and [tasks]
## name = "command" pairs. Values are quoted strings; comments and blank lines are ignored.
func parse_manifest(project: Project*, text: str) -> !:
    var section = ""
    let lines = try strings.split(text, '\n')
    defer free(lines) in memory.heap
    for raw in lines:
        let line = strings.trim(raw)
        if line.length == 0 or strings.starts_with(line, "#"):
            continue
        if strings.starts_with(line, "["):
            section = strings.trim(strip(line, "[", "]"))
            continue
        let (key_raw, value_raw) = strings.split_once(line, "=") else continue
        let key = strings.trim(key_raw)
        let value = unquote(strings.trim(value_raw))
        if section == "package":
            if key == "name":
                try replace_text(&project.name, value)
            elif key == "language":
                try replace_text(&project.language, value)
            elif key == "entry":
                try replace_text(&project.entry, value)
        elif section == "tasks":
            let slot = try task_slot(project, key)
            try replace_text(&project.tasks[slot].command, value)
        elif strings.starts_with(section, "tasks."):
            let slot = try task_slot(project, (str)section.bytes[6..])
            if key == "cmd":
                try replace_text(&project.tasks[slot].command, value)
            elif key == "description":
                try replace_text(&project.tasks[slot].description, value)
            elif key == "depends":
                let replacement = try string_array(value)
                for dependency in project.tasks[slot].depends: strings.release(dependency)
                if project.tasks[slot].depends.length > 0: free(project.tasks[slot].depends) in memory.heap
                project.tasks[slot].depends = replacement

func replace_text(target: str*, value: str) -> !:
    let replacement = try strings.copy(value)
    strings.release(*target)
    *target = replacement

func unquote(text: str) -> str:
    if text.length >= 2 and strings.starts_with(text, "\"") and strings.ends_with(text, "\""):
        return (str)text.bytes[1..<text.length - 1]
    return text

func strip(text: str, open: str, close: str) -> str:
    var inner = text
    if strings.starts_with(inner, open):
        inner = (str)inner.bytes[open.length..]
    if strings.ends_with(inner, close):
        inner = (str)inner.bytes[..<inner.length - close.length]
    return inner

## The index of the task named `name`, creating an empty one when it is new; a task can be
## introduced by a plain [tasks] line or a [tasks.<name>] subtable, in any order.
func task_slot(project: Project*, name: str) -> usize!:
    var index: usize = 0
    while index < project.task_count:
        if project.tasks[index].name == name:
            return index
        index += 1
    if project.task_count >= project.tasks.length:
        error(usage_error, "too many tasks in package.prisma")
    let owned_name = try strings.copy(name)
    errdefer strings.release(owned_name)
    let command = try strings.copy("")
    errdefer strings.release(command)
    let description = try strings.copy("")
    errdefer strings.release(description)
    project.tasks[project.task_count] = Task(name = owned_name, command = command, description = description)
    project.task_count += 1
    return project.task_count - 1

## Parse a `["a", "b"]` TOML string array into a slice; empty items are dropped.
func string_array(value: str) -> str[]!:
    let inner = strip(strings.trim(value), "[", "]")
    var result: str[]
    let parts = try strings.split(inner, ',')
    defer free(parts) in memory.heap
    for part in parts:
        let item = unquote(strings.trim(part))
        if item.length > 0:
            result = try append(result, try strings.copy(item))
    return result

# mark: Running things =========================================================================

## Run `program` with `arguments`, forwarding its output and returning its exit code. Dynamic
## strings become NUL-terminated copies so they cross the process boundary as `c.str`.
func spawn(program: str, arguments: str[]) -> i32!:
    let program_text = try strings.copy(program)
    defer strings.release(program_text)
    let argv = try alloc c.str[arguments.length]
    var index: usize = 0
    defer release_spawn_arguments(argv, index)
    while index < arguments.length:
        argv[index] = (c.str)try strings.copy(arguments[index])
        index += 1
    let (status, out, err) = try process.run((c.str)program_text, argv)
    defer process.release(out)
    defer process.release(err)
    if out.length > 0:
        try io.stdout().write(out)
    if err.length > 0:
        try io.stderr().write(err)
    return status

func release_spawn_arguments(arguments: c.str[], count: usize):
    for i in 0..<count: strings.release((str)arguments[i])
    if arguments.length > 0: free(arguments) in memory.heap

## The project's build output path, build/<name> under its root.
func output_path(project: Project*) -> str!:
    let directory = try paths.join(project.root, "build")
    defer strings.release(directory)
    return try paths.join(directory, project.name)

## Build the project's entry into build/<name> under the project root.
func build(project: Project*, release: bool, extra: str[]) -> i32!:
    let entry = try project.entry_path()
    defer strings.release(entry)
    try ensure_build(project)
    let output = try output_path(project)
    defer strings.release(output)
    var arguments: str[]
    defer release_string_array(arguments)
    for word in ["build", entry, "--native", "-o", output]:
        arguments = try append(arguments, word)
    if release:
        arguments = try append(arguments, "--release")
    let combined = try concat(arguments, extra)
    defer release_string_array(combined)
    var label: u8[160]
    let status = try progress.run(try format(label, f"compiling {project.name}"), try project.compiler(), combined)
    if status != 0 or not try project_file.exists_in(project.root): return status
    # A declared application is also wrapped as Name.app / Name.AppDir beside the executable.
    var definition = try project_file.read(project.root)
    defer definition.close()
    if definition.is_bundled(): try apps.bundle(project.root, &definition)
    return status

func ensure_build(project: Project*) -> !:
    let directory = try paths.join(project.root, "build")
    defer strings.release(directory)
    let terminated = try strings.copy(directory)
    defer strings.release(terminated)
    if not files.exists((c.str)terminated):
        try files.create_directory((c.str)terminated)

## Build, then run the produced binary with `arguments`.
func run_app(project: Project*, release: bool, arguments: str[]) -> i32!:
    var no_extra: str[]
    let status = try build(project, release, no_extra)
    if status != 0:
        return status
    let executable = try output_path(project)
    defer strings.release(executable)
    return try spawn(executable, arguments)

## A task run in progress: the tasks already finished (each runs once) and the tasks on the
## current dependency chain (to catch a cycle).
struct Runner:
    var project: Project*
    var done: str[]
    var done_count: usize
    var active: str[]
    var active_count: usize

## Run task `name`, its `depends` first (each at most once), forwarding `passthrough` only to
## the named target. Fails on an unknown task or a dependency cycle.
func run_task(project: Project*, name: str, passthrough: str[]) -> i32!:
    var runner = Runner(project = project)
    runner.done = try alloc str[project.task_count + 1]
    runner.active = try alloc str[project.task_count + 1]
    return try run_graph(&runner, name, passthrough, true)

func run_graph(runner: Runner*, name: str, passthrough: str[], target: bool) -> i32!:
    var index: usize = 0
    while index < runner.done_count:
        if runner.done[index] == name:
            return 0
        index += 1
    index = 0
    while index < runner.active_count:
        if runner.active[index] == name:
            error(usage_error, try format(message_buffer[0..], f"task dependency cycle at '{name}'"))
        index += 1
    let task = runner.project.find_task(name) else error(usage_error, try format(message_buffer[0..], f"no task named '{name}'"))
    runner.active[runner.active_count] = name
    runner.active_count += 1
    for dependency in task.depends:
        var none_args: str[]
        let dependency_status = try run_graph(runner, dependency, none_args, false)
        if dependency_status != 0:
            return dependency_status
    var args: str[]
    if target:
        args = passthrough
    let status = try run_command(task.command, args)
    runner.active_count -= 1
    runner.done[runner.done_count] = name
    runner.done_count += 1
    return status

## Run a task's command through the host's shell (so `&&`, pipes and redirects work),
## forwarding `args`. POSIX uses `sh -c`, Windows uses `cmd /c`, so tasks run on either.
func run_command(command: str, args: str[]) -> i32!:
    if platform.windows:
        # cmd has no `$@`; append the arguments to the command line, space separated.
        var windows: str[]
        windows = try append(windows, "/c")
        windows = try append(windows, try join_with(command, args))
        return try spawn("cmd", windows)
    # sh -c "<command> \"$@\"" sh <args>: the args become $1.. so "$@" forwards them.
    var script = command
    if args.length > 0:
        var buffer: u8[2048]
        script = try strings.copy(try format(buffer[0..], f"{command} \"$@\""))
    var argv: str[]
    for word in ["-c", script, "sh"]:
        argv = try append(argv, word)
    return try spawn("sh", try concat(argv, args))

## `command` followed by each argument, space separated, as one command line.
func join_with(command: str, args: str[]) -> str!:
    var parts: str[]
    parts = try append(parts, command)
    return try strings.join(try concat(parts, args), " ")

## A two-word argument list as a slice (fixed-size literals do not coerce to `str[]`).
func two(first: str, second: str) -> str[]!:
    var result: str[]
    result = try append(result, first)
    result = try append(result, second)
    return result

func list_tasks(project: Project*) -> !:
    if project.task_count == 0:
        try io.stdout().write("no tasks are defined in package.prisma\n")
        return
    try io.stdout().write("tasks:\n")
    var index: usize = 0
    while index < project.task_count:
        let task = project.tasks[index]
        if task.description.length > 0:
            try io.stdout().write(f"  {task.name}  -  {task.description}\n")
        else:
            try io.stdout().write(f"  {task.name}\n")
        index += 1

# mark: Dependencies ==========================================================================

# mark: Applications ===========================================================================

## `luc install <owner>/<name>[@<version>]`: fetch, build and install an application.
func install_command(own: str[], updating: bool = false) -> i32!:
    if own.length != 1: error(usage_error, "usage: luc install <owner>/<name>[@<version>]")
    let (coordinate, requirement) = strings.split_once(own[0], "@") else (own[0], "")
    let (owner, name) = strings.split_once(coordinate, "/") else error(usage_error, "usage: luc install <owner>/<name>[@<version>]")
    let home = try apps.home()
    defer strings.release(home)
    let scratch = try apps.child(home, "build")
    defer strings.release(scratch)
    let work = try paths.join(scratch, name)
    defer strings.release(work)
    let work_z = try strings.copy(work)
    defer strings.release(work_z)
    if files.exists((c.str)work_z): try files.remove_tree((c.str)work_z)
    defer discard(files.remove_tree((c.str)work_z) catch: recover ())
    var version_buffer: u8[64]
    try progress.step(f"fetching {coordinate}")
    let version = try packages.download(owner, name, requirement, work, version_buffer)
    try progress.detail(f"version {version}")

    let installed = try apps.child(home, "apps")
    defer strings.release(installed)
    let application = try apps.child(installed, name)
    defer strings.release(application)
    let placed = try paths.join(application, version)
    defer strings.release(placed)
    let placed_z = try strings.copy(placed)
    defer strings.release(placed_z)
    if files.exists((c.str)placed_z):
        if updating:
            try io.stdout().write(f"{coordinate} {version} is the newest; it is installed\n")
        else:
            try io.stdout().write(f"{coordinate} {version} is already installed\n")
        return 0

    var definition = try project_file.read(work)
    defer definition.close()
    if definition.is_package(): error(usage_error, "that is a package, a library to build on; use 'luc add' inside a project")
    var project = try load_project(directory_hint = work, registry = true)
    defer project.close()
    try progress.step(f"building {coordinate} {version} from source")
    var no_extra: str[]
    let status = try build(&project, true, no_extra)
    if status != 0: error(usage_error, "the application did not build")

    var plan_buffer: u8[1024]
    var bundle_buffer: u8[96]
    let bundled = try apps.bundle_name(&definition, bundle_buffer) if definition.is_bundled() else ""
    var plan = try format(plan_buffer, f"copy build/{project.name} -> bin/{name}\nlink {name} -> bin/{name}\n")
    if bundled.length > 0 and definition.install.length == 0:
        let built_build = try paths.join(work, "build")
        defer strings.release(built_build)
        let built = try paths.join(built_build, bundled)
        defer strings.release(built)
        let status_code = try install_application(&definition, built, application, placed, home, name, coordinate, version)
        try remove_other_versions(application, version)
        return status_code
    var scripted = ""
    defer if_release(scripted)
    if definition.install.length > 0:
        scripted = try apps.scripted_plan(os.env((c.str)"LUCE") else "luce", work, definition.install, name, version)
        plan = scripted

    let staging = try paths.join(application, ".staging")
    defer strings.release(staging)
    let staging_z = try strings.copy(staging)
    defer strings.release(staging_z)
    if files.exists((c.str)staging_z): try files.remove_tree((c.str)staging_z)
    try files.create_directory((c.str)staging_z)
    errdefer discard(files.remove_tree((c.str)staging_z) catch: recover ())
    var links: u8[16384]
    var links_used: usize
    try apps.apply(plan, work, staging, links[0..], &links_used)
    let record = try paths.join(staging, ".luc-links")
    defer strings.release(record)
    let record_z = try strings.copy(record)
    defer strings.release(record_z)
    try files.write((c.str)record_z, links[..<links_used])
    try files.rename((c.str)staging_z, (c.str)placed_z, replace = false)

    let commands = try apps.child(home, "bin")
    defer strings.release(commands)
    var start: usize
    for end in 0..<links_used:
        if links[end] != '\n': continue
        let (command, relative) = strings.split_once((str)links[start..<end], "\t") else continue
        start = end + 1
        let target = try paths.join(placed, relative)
        defer strings.release(target)
        let target_z = try strings.copy(target)
        defer strings.release(target_z)
        if not files.exists((c.str)target_z): error(usage_error, "the install plan links a file it did not copy")
        try apps.link_command(commands, command, target)
        try io.stdout().write(f"  {command} -> {target}\n")
    try remove_other_versions(application, version)
    try io.stdout().write(f"installed {coordinate} {version}\n")
    return 0

## Once a version is installed it replaces the others: their records go, and with them
## what they copied under ~/.luce. What they placed for the desktop the new version has
## replaced already, so it stays.
func remove_other_versions(application: str, kept: str) -> !:
    let application_z = try strings.copy(application)
    defer strings.release(application_z)
    let versions = try files.list((c.str)application_z)
    defer files.release_list(versions)
    for version in versions:
        if version == kept or strings.starts_with(version, "."): continue
        let inner = try paths.join(application, version)
        defer strings.release(inner)
        let inner_z = try strings.copy(inner)
        defer strings.release(inner_z)
        try files.remove_tree((c.str)inner_z)
        try progress.detail(f"removed version {version}")

## Install a desktop application: the bundle goes where the system keeps applications
## (apps.place), ~/.luce/apps/<name>/<version>/ records what was created, and
## ~/.luce/bin/<name> starts it from a terminal.
func install_application(definition: pkg.Definition*, built: str, application: str, placed: str, home: str, name: str, coordinate: str, version: str) -> i32!:
    try progress.step(f"installing {definition.application.name}")
    var record: u8[4096]
    var used: usize
    let executable = try apps.place(definition, built, record, &used)
    defer strings.release(executable)
    let staging = try paths.join(application, ".staging")
    defer strings.release(staging)
    let staging_z = try strings.copy(staging)
    defer strings.release(staging_z)
    if files.exists((c.str)staging_z): try files.remove_tree((c.str)staging_z)
    try files.create_directory((c.str)staging_z)
    errdefer discard(files.remove_tree((c.str)staging_z) catch: recover ())
    let placed_note = try paths.join(staging, ".luc-placed")
    defer strings.release(placed_note)
    let placed_note_z = try strings.copy(placed_note)
    defer strings.release(placed_note_z)
    try files.write((c.str)placed_note_z, record[..<used])
    var link_line: u8[1200]
    let links_note = try paths.join(staging, ".luc-links")
    defer strings.release(links_note)
    let links_note_z = try strings.copy(links_note)
    defer strings.release(links_note_z)
    try files.write((c.str)links_note_z, (try format(link_line, f"{name}\t{executable}\n")).bytes)
    let placed_z = try strings.copy(placed)
    defer strings.release(placed_z)
    try files.rename((c.str)staging_z, (c.str)placed_z, replace = false)
    let commands = try apps.child(home, "bin")
    defer strings.release(commands)
    try apps.link_command(commands, name, executable)
    var start: usize
    for end in 0..<used:
        if record[end] != '\n': continue
        try progress.detail(f"{(str)record[start..<end]}")
        start = end + 1
    try progress.detail(f"{name} -> {executable}")
    try io.stdout().write(f"installed {coordinate} {version}: open {definition.application.name} from your applications, or run {name}\n")
    return 0

## ~/.luce/session.vault, where `luc login` saves the session unless told otherwise.
func default_vault() -> str!:
    let home = try apps.home()
    defer strings.release(home)
    return try paths.join(home, "session")

func account_file() -> str!:
    let home = try apps.home()
    defer strings.release(home)
    return try paths.join(home, "account")

## Only the real registry's account is remembered: a test or a loopback registry must
## never change who `luc login` logs in as.
func remember_account(origin: str, account: str) -> !:
    if origin != registry_http.production_origin: return
    let path = try account_file()
    defer strings.release(path)
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    try files.write((c.str)terminated, account.bytes)

## The account last registered or logged in here, or empty.
func remembered_account() -> str!:
    let path = try account_file()
    defer strings.release(path)
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    if not files.exists((c.str)terminated): return try strings.copy("")
    let bytes = try files.read_limit((c.str)terminated, 128)
    defer free(bytes) in memory.heap
    return try strings.copy(strings.trim((str)bytes))

## `luc info`: the project as other tools see it, one `key<TAB>value` per line. Written
## for luced, which asks luc about a project rather than reading package.prisma itself.
## Keys: root, name, owner, version, kind, language, entry, source, dependency (repeated:
## name TAB owner TAB version TAB path-or-empty), locked (repeated: name TAB version),
## generated (repeated: a path luc writes and the editor should hide).
func info_command() -> i32!:
    var project = try load_project(prepare = false)
    defer project.close()
    if not try project_file.exists_in(project.root): error(usage_error, "not in a Luce project (no package.prisma found)")
    var definition = try project_file.read(project.root)
    defer definition.close()
    var out = io.stdout()
    try out.write(f"root\t{project.root}\nname\t{definition.name}\nowner\t{definition.owner}\nversion\t{definition.version}\nkind\t{definition.kind}\nlanguage\t{definition.language}\nentry\t{definition.entry}\nsource\t{definition.source}\n")
    for i in 0..<definition.dependency_count:
        let item = try definition.dependency_at(i)
        try out.write(f"dependency\t{item.name}\t{item.owner}\t{item.version}\t{item.path}\n")
    var graph = packages.read_lock(project.root) catch:
        recover packages.Graph()
    defer graph.close()
    for i in 0..<graph.count:
        try out.write(f"locked\t{graph.packages[i].name}\t{graph.packages[i].version}\n")
    for generated in ["build", ".luc"]:
        try out.write(f"generated\t{generated}\n")
    return 0

func if_release(text: str):
    if text.length > 0: process.release(text)

## `luc uninstall <name>`: remove an application and the commands it linked. Runs no package code.
func uninstall_command(own: str[]) -> i32!:
    if own.length != 1: error(usage_error, "usage: luc uninstall <name>")
    let name = own[0]
    for byte in name.bytes:
        if byte == '/' or byte == '.' or byte == 0: error(usage_error, "usage: luc uninstall <name>")
    let home = try apps.home()
    defer strings.release(home)
    let installed = try apps.child(home, "apps")
    defer strings.release(installed)
    let application = try paths.join(installed, name)
    defer strings.release(application)
    let application_z = try strings.copy(application)
    defer strings.release(application_z)
    if not files.exists((c.str)application_z):
        try io.stderr().write(f"luc: {name} is not installed\n")
        return 1
    let commands = try apps.child(home, "bin")
    defer strings.release(commands)
    let entries = try files.list((c.str)try strings.copy(commands))
    defer files.release_list(entries)
    for entry in entries:
        let link = try paths.join(commands, entry)
        defer strings.release(link)
        let link_z = try strings.copy(link)
        defer strings.release(link_z)
        let target = files.read_symlink((c.str)link_z) catch: continue
        if strings.starts_with(target, application) and target.length > application.length and target.bytes[application.length] == '/':
            try files.remove_file((c.str)link_z)
    # Remove what each installed version placed outside ~/.luce and the commands it linked.
    let versions = try files.list((c.str)application_z)
    defer files.release_list(versions)
    for version in versions:
        let inner = try paths.join(application, version)
        defer strings.release(inner)
        try remove_recorded(inner, commands)
    try files.remove_tree((c.str)application_z)
    try io.stdout().write(f"uninstalled {name}\n")
    return 0

## Undo an application install recorded in `inner`: every path in .luc-placed, and each
## command in .luc-links that is still a link.
func remove_recorded(inner: str, commands: str) -> !:
    let placed_note = try paths.join(inner, ".luc-placed")
    defer strings.release(placed_note)
    let placed_z = try strings.copy(placed_note)
    defer strings.release(placed_z)
    if not files.exists((c.str)placed_z): return
    let recorded = try files.read_limit((c.str)placed_z, 4096)
    defer free(recorded) in memory.heap
    var start: usize
    for end in 0..<recorded.length:
        if recorded[end] != '\n': continue
        try apps.unplace((str)recorded[start..<end])
        start = end + 1
    let links_note = try paths.join(inner, ".luc-links")
    defer strings.release(links_note)
    let links_z = try strings.copy(links_note)
    defer strings.release(links_z)
    if not files.exists((c.str)links_z): return
    let links = try files.read_limit((c.str)links_z, 16384)
    defer free(links) in memory.heap
    start = 0
    for end in 0..<links.length:
        if links[end] != '\n': continue
        let (command, target) = strings.split_once((str)links[start..<end], "\t") else (strings.trim((str)links[start..<end]), "")
        discard(target)
        start = end + 1
        try apps.unlink_command(commands, command)

## `luc list`: installed applications and their versions.
func list_command() -> i32!:
    let home = try apps.home()
    defer strings.release(home)
    let installed = try apps.child(home, "apps")
    defer strings.release(installed)
    let names = try files.list((c.str)try strings.copy(installed))
    defer files.release_list(names)
    for name in names:
        let application = try paths.join(installed, name)
        defer strings.release(application)
        let versions = try files.list((c.str)try strings.copy(application))
        defer files.release_list(versions)
        for version in versions:
            if not strings.starts_with(version, "."): try io.stdout().write(f"{name} {version}\n")
    return 0

func add_command(project: Project*, own: str[]) -> i32!:
    let manifest = try require_manifest(project)
    strings.release(manifest)
    var location = ""
    for word in own:
        if not strings.starts_with(word, "--"): location = word
    if location.length == 0:
        error(usage_error, "luc add needs a package: luc add <owner>/<name> or luc add <path-to-package>")
    if not try project_file.exists_in(location):
        # Not a local package: a registry coordinate, pinned to its newest release.
        let (owner, name) = strings.split_once(location, "/") else error(usage_error, "no package.prisma at that path, and not an <owner>/<name> coordinate")
        var newest: u8[64]
        let version = try packages.latest(owner, name, newest)
        var requirement: u8[80]
        try project_file.add_registry_dependency(project.root, owner, name, try format(requirement, f"^{version}"))
        discard(try packages.lock(project.root))
        discard(try packages.sync(project.root))
        try project_file.generate(project.root, project.root)
        try io.stdout().write(f"added dependency {location} ^{version}\n")
        return 0
    let name = try project_file.add_dependency(project.root, location)
    defer strings.release(name)
    try project_file.generate(project.root, project.root)
    try io.stdout().write(f"added dependency {name} from {location}\n")
    return 0

## `luc remove <name>` drops a dependency from package.prisma.
func remove_command(project: Project*, own: str[]) -> i32!:
    let manifest = try require_manifest(project)
    strings.release(manifest)
    var name = ""
    for word in own:
        if not strings.starts_with(word, "--"):
            name = word
            break
    if name.length == 0:
        error(usage_error, "luc remove needs a name: luc remove <name>")
    if not try project_file.remove_dependency(project.root, name):
        try io.stderr().write(f"luc: no dependency named '{name}'\n")
        return 1
    try project_file.generate(project.root, project.root)
    try io.stdout().write(f"removed dependency {name}\n")
    return 0

## `luc clean` removes the project's build/ directory (binary and cache); `luc clean cache`
## removes only build/.cache, keeping the built binary.
func clean_command(project: Project*, own: str[]) -> i32!:
    let manifest = try require_manifest(project)
    strings.release(manifest)
    var target = try paths.join(project.root, "build")
    var label = "build"
    if own.length > 0 and own[0] == "cache":
        target = try paths.join(target, ".cache")
        label = "build/.cache"
    let terminated = try strings.copy(target)
    if not files.exists((c.str)terminated):
        try io.stdout().write(f"nothing to clean ({label} is not present)\n")
        return 0
    try files.remove_tree((c.str)terminated)
    try io.stdout().write(f"removed {target}\n")
    return 0

## This project's package.prisma, or a usage error when there is no project here.
func require_manifest(project: Project*) -> str!:
    if not try project_file.exists_in(project.root):
        error(usage_error, "not in a Luce project (no package.prisma found); run 'luc init' first")
    return try paths.join(project.root, project_file.file_name)

func package_name_at(manifest: str) -> str!:
    var probe = Project(root = try strings.copy(""), name = try strings.copy(""),
        language = try strings.copy("luce-base"), entry = try strings.copy(""))
    probe.tasks = try alloc Task[1]
    defer probe.close()
    let filename = try strings.copy(manifest)
    defer strings.release(filename)
    let contents = try files.read((c.str)filename)
    defer free(contents) in memory.heap
    try parse_manifest(&probe, (str)contents)
    if probe.name.length == 0:
        error(usage_error, try format(message_buffer[0..], f"the package at {manifest} has no [package] name"))
    if probe.name.length > 128: error(usage_error, "dependency package name is too long")
    for i in 0..<probe.name.length:
        let byte = probe.name.bytes[i]
        let letter = byte >= 'a' and byte <= 'z'
        if not letter and byte != '_' and (i == 0 or byte < '0' or byte > '9'):
            error(usage_error, "dependency package name must be a lowercase identifier")
    return try strings.copy(probe.name)

func release_string_array(values: str[]):
    if values.length > 0: free(values) in memory.heap

## Add or replace `name = "value"` under `[dependencies]`, creating the section if absent,
## and preserving the rest of the file line for line.
func upsert_dependency(manifest: str, name: str, value: str) -> !:
    let entry = try toml_line(name, value)
    defer strings.release(entry)
    let filename = try strings.copy(manifest)
    defer strings.release(filename)
    let contents = try files.read((c.str)filename)
    defer free(contents) in memory.heap
    let text = (str)contents
    var result: str[]
    defer release_string_array(result)
    var section = ""
    var has_section = false
    let lines = try strings.split(text, '\n')
    defer free(lines) in memory.heap
    for raw in lines:
        let trimmed = strings.trim(raw)
        if strings.starts_with(trimmed, "["):
            section = trimmed
            result = try append(result, raw)
            if trimmed == "[dependencies]":
                has_section = true
                result = try append(result, entry)
            continue
        if section == "[dependencies]" and dependency_key(trimmed) == name:
            continue
        result = try append(result, raw)
    if not has_section:
        result = try append(result, "[dependencies]")
        result = try append(result, entry)
        result = try append(result, "")
    let joined = try strings.join(result, "\n")
    defer strings.release(joined)
    try files.write_text(manifest, joined)

## Remove `name = ...` under `[dependencies]`; answers whether a line was removed.
func remove_dependency(manifest: str, name: str) -> bool!:
    let filename = try strings.copy(manifest)
    defer strings.release(filename)
    let contents = try files.read((c.str)filename)
    defer free(contents) in memory.heap
    let text = (str)contents
    var result: str[]
    defer release_string_array(result)
    var section = ""
    var removed = false
    let lines = try strings.split(text, '\n')
    defer free(lines) in memory.heap
    for raw in lines:
        let trimmed = strings.trim(raw)
        if strings.starts_with(trimmed, "["):
            section = trimmed
            result = try append(result, raw)
            continue
        if section == "[dependencies]" and dependency_key(trimmed) == name:
            removed = true
            continue
        result = try append(result, raw)
    if removed:
        let joined = try strings.join(result, "\n")
        defer strings.release(joined)
        try files.write_text(manifest, joined)
    return removed

## The key of a `key = value` line, or empty for anything else.
func dependency_key(line: str) -> str:
    if line.length == 0 or strings.starts_with(line, "#"):
        return ""
    let (key, _) = strings.split_once(line, "=") else return ""
    return strings.trim(key)

func toml_line(key: str, value: str) -> str!:
    var buffer: u8[1024]
    return try strings.copy(try format(buffer[0..], f"{key} = \"{value}\""))

# mark: Updating the toolchain ================================================================

## `luc update` (alias `upgrade`) reinstalls the latest luc + luce-base + luce by re-running
## the official installers from luciaos.com. luc ships inside the luce-base release, so
## updating luce-base updates luc too. `--dry-run` prints the commands without running them.
## `luc update`: the whole toolset (luce, luce-base and luc, one release archive) through
## the Luce installer. `luc update owner/name`: that application or tool at its newest
## version, replacing what is installed.
func update_command(own: str[]) -> i32!:
    for word in own:
        if not strings.starts_with(word, "--"):
            return try install_command(own, updating = true)
    let command = try installer_command("luce")
    if has(own, "--dry-run"):
        try io.stdout().write(f"{command}\n")
        return 0
    try progress.step(f"updating luce, luce-base and luc from https://luce.luciaos.com")
    if platform.windows:
        # Windows will not replace a running luc.exe: the installer runs in its own window
        # once this process has exited and released it
        let detached = try strings.join(["Start-Process powershell -ArgumentList '-NoExit','-NoProfile','-Command','Start-Sleep 1; ", command, "'"], "")
        if try run_shell(detached) != 0:
            try io.stderr().write("luc: could not start the installer\n")
            return 1
        try io.stdout().write("the update continues in a new PowerShell window\n")
        return 0
    if try run_shell(command) != 0:
        try io.stderr().write("luc: the update did not complete\n")
        return 1
    return 0

## The one-line installer pipeline for a site: curl|sh on POSIX, irm|iex on Windows.
func installer_command(site: str) -> str!:
    var buffer: u8[512]
    if platform.windows:
        return try strings.copy(try format(buffer[0..], f"irm https://{site}.luciaos.com/install.ps1 | iex"))
    return try strings.copy(try format(buffer[0..], f"curl -fsSL https://{site}.luciaos.com/install.sh | sh"))

## Run a shell pipeline through the host shell.
func run_shell(command: str) -> i32!:
    if platform.windows:
        var windows: str[]
        for word in ["-NoProfile", "-Command", command]:
            windows = try append(windows, word)
        return try spawn("powershell", windows)
    return try spawn("sh", try two("-c", command))

# mark: Scaffolding ===========================================================================

## `luc new <path>` creates a project in a new directory; `luc init` in the current one.
## Flags: --package (a library) or --app (default); --luce or --luce-base (default).
func scaffold_command(command: str, own: str[]) -> i32!:
    # One of three kinds: a package (library), an application (desktop window) or a tool
    # (terminal program, the default). --lib is the older spelling of --package.
    var kind = "tool"
    if has(own, "--package") or has(own, "--lib"): kind = "package"
    elif has(own, "--application") or has(own, "--app"): kind = "application"
    elif has(own, "--tool"): kind = "tool"
    let language = "luce" if has(own, "--luce") or kind == "application" else "luce-base"
    var target = try os.cwd()
    if command == "new":
        var chosen = ""
        for word in own:
            if not strings.starts_with(word, "--"):
                chosen = word
        if chosen.length == 0:
            error(usage_error, "usage: luc new <dir> [--package | --application | --tool] [--luce]")
        target = chosen
    let name = paths.base(target)
    if try project_file.exists_in(target):
        error(usage_error, "a package.prisma already exists here; refusing to overwrite it")
    try scaffold(target, name, language, kind)
    try io.stdout().write(f"created {language} {kind} '{name}' in {target}\n")
    return 0

## Write the project's directories and starter files.
func scaffold(target: str, name: str, language: str, kind: str) -> !:
    try ensure_dir(target)
    let source = try paths.join(target, "src")
    try ensure_dir(source)
    let suffix = ".luc" if language == "luce" else ".lucb"
    var definition: u8[2048]
    try write_file(try paths.join(target, project_file.file_name), try project_file.scaffold(name, default_owner, language, kind, definition))
    try write_file(try paths.join(target, ".gitignore"), "build/\n.luc/\n")
    if kind == "package":
        # A package may be named luce-json; its module is the identifier luce_json.
        let module = try project_file.module_name(name)
        defer strings.release(module)
        let module_dir = try paths.join(source, module)
        try ensure_dir(module_dir)
        try write_file(try paths.join(module_dir, try join_name(module, suffix)), try library_source(module, language))
    elif kind == "application":
        var window: u8[1024]
        try write_file(try paths.join(source, "main.luc"), try format(window, f"from ui import Application, Button, Text, VStack\n\npub func main(arguments: list[str]) -> int!:\n    let button = Button(\"Continue\")\n    let content = VStack([Text(\"Hello from {name}\"), button], padding = 24.0)\n    let app = Application(content, title = \"{name}\")\n    app.run()\n    return 0\n"))
    else:
        try write_file(try paths.join(source, try join_name("main", suffix)), try program_source(name, language))

func ensure_dir(path: str) -> !:
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    if not files.exists((c.str)terminated):
        try files.create_directory((c.str)terminated)

func write_file(path: str, content: str) -> !:
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    try files.write((c.str)terminated, content.bytes)

func join_name(stem: str, suffix: str) -> str!:
    var buffer: u8[128]
    return try strings.copy(try format(buffer[0..], f"{stem}{suffix}"))

func program_source(name: str, language: str) -> str!:
    var buffer: u8[512]
    if language == "luce":
        return try strings.copy(try format(buffer[0..], f"pub func main(arguments: list[str]) -> int!:\n    print(\"hello from {name}\")\n    return 0\n"))
    return try strings.copy(try format(buffer[0..], f"pub func main(arguments: str[]) -> i32:\n    print(\"hello from {name}\")\n    return 0\n"))

func library_source(name: str, language: str) -> str!:
    var buffer: u8[512]
    return try strings.copy(try format(buffer[0..], f"## The {name} package.\npub func greeting() -> str:\n    return \"hello from {name}\"\n"))

# mark: The command line =======================================================================

func append(items: str[], value: str) -> str[]!:
    let grown = try alloc str[items.length + 1]
    var index: usize = 0
    while index < items.length:
        grown[index] = items[index]
        index += 1
    grown[items.length] = value
    if items.length > 0: free(items) in memory.heap
    return grown

func concat(left: str[], right: str[]) -> str[]!:
    let grown = try alloc str[left.length + right.length]
    var index: usize = 0
    while index < left.length:
        grown[index] = left[index]
        index += 1
    var offset: usize = 0
    while offset < right.length:
        grown[left.length + offset] = right[offset]
        offset += 1
    return grown

## Split the arguments after the command into its own words and the passthrough after `--`.
func partition(arguments: c.str[], start: usize) -> (str[], str[])!:
    var own: str[]
    var passthrough: str[]
    var index = start
    var seen_dashes = false
    while index < arguments.length:
        let word = (str)arguments[index]
        if word == "--" and not seen_dashes:
            seen_dashes = true
        elif seen_dashes:
            passthrough = try append(passthrough, word)
        else:
            own = try append(own, word)
        index += 1
    return (own, passthrough)

func has(words: str[], flag: str) -> bool:
    for word in words:
        if word == flag:
            return true
    return false

pub func main(arguments: c.str[]) -> i32!:
    with memory.heap:
        if arguments.length < 2:
            try usage(io.stdout())
            return 0
        let command = (str)arguments[1]
        if command == "--version":
            try io.stdout().write(f"luc {luc_version}\n")
            return 0
        if command == "--help" or command == "help":
            try usage(io.stdout())
            return 0
        if command == "remote-refs":
            if arguments.length == 6 and (str)arguments[3] == "--vault" and (str)arguments[5] == "--password-stdin":
                if ((str)arguments[4]).length == 0: error(usage_error, "vault path is required")
                return try remote.refs((str)arguments[2], (str)arguments[4])
            if arguments.length != 3: error(usage_error, "usage: luc remote-refs <registry-git-url>")
            return try remote.refs((str)arguments[2])
        if command == "git-credential":
            if arguments.length != 3: return 0
            let session = try default_vault()
            defer strings.release(session)
            return try releasing.credential_helper((str)arguments[2], session)
        if command == "publish":
            var notes = ""
            var index: usize = 2
            while index < arguments.length:
                let word = (str)arguments[index]
                index += 1
                if (word == "-m" or word == "--notes") and index < arguments.length:
                    notes = (str)arguments[index]
                    index += 1
                else:
                    error(usage_error, "usage: luc publish -m \"what changed in this version\"")
            var project = try load_project(prepare = false)
            defer project.close()
            let manifest = try require_manifest(&project)
            strings.release(manifest)
            let session = try default_vault()
            defer strings.release(session)
            return try releasing.publish(project.root, packages.origin(), session, notes)
        # Secrets are prompted for at a terminal and read from a pipe otherwise, so the
        # old --*-stdin flags are accepted and ignored. The session vault defaults to
        # ~/.luce/session.vault.
        if command == "login" or command == "register" or command == "repo-create" or command == "git-token":
            var words: str[]
            defer release_string_array(words)
            var vault = ""
            var index: usize = 2
            while index < arguments.length:
                let word = (str)arguments[index]
                index += 1
                if word == "--secrets-stdin" or word == "--passwords-stdin" or word == "--password-stdin": continue
                if word == "--vault" and index < arguments.length:
                    vault = (str)arguments[index]
                    index += 1
                    continue
                words = try append(words, word)
            let fallback = try default_vault()
            defer strings.release(fallback)
            # The origin may be omitted: it is the Lucia OS registry unless one is given.
            var origin = packages.origin()
            var first: usize = 0
            if words.length > 0 and strings.starts_with(words[0], "http"):
                origin = words[0]
                first = 1
            let rest = words[first..]
            if command == "register":
                if rest.length != 1: error(usage_error, "usage: luc register <account>")
                let status = try credentials.register(origin, rest[0])
                if status == 0: try remember_account(origin, rest[0])
                return status
            if command == "login":
                if rest.length > 1: error(usage_error, "usage: luc login [<account>]")
                let remembered = try remembered_account()
                defer strings.release(remembered)
                let account = rest[0] if rest.length > 0 else remembered
                if account.length == 0: error(usage_error, "usage: luc login <account>   (the account is remembered afterwards)")
                let status = try credentials.login_session(origin, account, fallback)
                if status == 0: try remember_account(origin, account)
                return status
            if command == "repo-create":
                if rest.length != 1: error(usage_error, "usage: luc repo-create <name>")
                return try credentials.create_repository(origin, rest[0], vault if vault.length > 0 else fallback)
            if rest.length != 2: error(usage_error, "usage: luc git-token <repository> <read|write>")
            return try credentials.issue_git_token(origin, rest[0], rest[1], vault if vault.length > 0 else fallback)
        if command == "remote-fetch":
            if arguments.length == 8 and (str)arguments[5] == "--vault" and (str)arguments[7] == "--password-stdin":
                if ((str)arguments[6]).length == 0: error(usage_error, "vault path is required")
                return try remote.fetch((str)arguments[2], (str)arguments[3], (str)arguments[4], (str)arguments[6])
            if arguments.length != 5: error(usage_error, "usage: luc remote-fetch <registry-git-url> <commit-id> <new-pack-path>")
            return try remote.fetch((str)arguments[2], (str)arguments[3], (str)arguments[4])
        if command == "checkout-pack":
            if arguments.length != 5: error(usage_error, "usage: luc checkout-pack <pack-path> <commit-id> <new-directory>")
            return try checkout.from_pack((str)arguments[2], (str)arguments[3], (str)arguments[4])
        let (own, passthrough) = try partition(arguments, 2)
        defer release_string_array(own)
        defer release_string_array(passthrough)
        if command == "info":
            return try info_command()
        if command == "install":
            return try install_command(own)
        if command == "uninstall":
            return try uninstall_command(own)
        if command == "list":
            return try list_command()
        if command == "new" or command == "init":
            return try scaffold_command(command, own)
        if command == "update" or command == "upgrade":
            return try update_command(own)
        let manages = command == "lock" or command == "sync" or command == "add" or command == "remove" or command == "clean"
        var project = try load_project(prepare = not manages)
        defer project.close()
        if command == "lock" or command == "sync":
            if passthrough.length != 0: error(usage_error, "lock and sync do not accept passthrough arguments")
            let manifest = try require_manifest(&project)
            strings.release(manifest)
            if command == "lock":
                if own.length != 0: error(usage_error, "usage: luc lock")
                let count = try packages.lock(project.root)
                try io.stdout().write(f"locked {count} registry package(s) in luc.lock\n")
            let offline = command == "sync" and own.length == 1 and own[0] == "--offline"
            if command == "sync" and own.length != 0 and not offline: error(usage_error, "usage: luc sync [--offline]")
            let count = try packages.sync(project.root, offline)
            try project_file.generate(project.root, project.root)
            try io.stdout().write(f"synced {count} registry package(s) into .luc/deps\n")
            return 0
        if command == "add":
            return try add_command(&project, own)
        if command == "remove":
            return try remove_command(&project, own)
        if command == "clean":
            return try clean_command(&project, own)
        if command == "build":
            return try build(&project, has(own, "--release"), passthrough)
        if command == "test":
            let base = try two("test", try project.entry_path())
            return try spawn(try project.compiler(), try concat(base, passthrough))
        if command == "check":
            return try spawn(try project.compiler(), try two("check", try project.entry_path()))
        if command == "fmt":
            var formatted = try two("fmt", try project.entry_path())
            if has(own, "--check"):
                formatted = try append(formatted, "--check")
            return try spawn(try project.compiler(), formatted)
        if command == "run":
            if own.length == 0 or own[0] == "--release":
                return try run_app(&project, has(own, "--release"), passthrough)
            if project.find_task(own[0]) != none:
                return try run_task(&project, own[0], passthrough)
            try io.stderr().write(f"luc: no task named '{own[0]}'\n")
            list_tasks(&project) catch failure:
                discard(failure)
            return 1
        try io.stderr().write(f"luc: unknown command '{command}'; run 'luc help'\n")
        return 1

func usage(out: io.Writer) -> !:
    try out.write("luc - the project tool for Luce and Luce Base\n\n")
    try out.write("Projects\n")
    try out.write("  new <dir> [--package|--tool|--application] [--luce]   create a project\n")
    try out.write("  init [same options]    create one in this directory\n\n")
    try out.write("Building and running\n")
    try out.write("  build [--release]      build into build/<name>\n")
    try out.write("  run [--release] [-- args]   build and run\n")
    try out.write("  run <task> [-- args]   run a task from package.prisma\n")
    try out.write("  test                   build and run the tests\n")
    try out.write("  check                  type-check without building\n")
    try out.write("  fmt [--check]          format the sources\n")
    try out.write("  clean [cache]          remove build/, or only its cache\n\n")
    try out.write("Dependencies\n")
    try out.write("  add owner/name         add a registry package\n")
    try out.write("  add ../path            add a package checked out beside this one\n")
    try out.write("  remove <name>          remove a dependency\n")
    try out.write("  lock                   resolve everything and write luc.lock\n")
    try out.write("  sync [--offline]       make .luc/deps match luc.lock\n\n")
    try out.write("Installing\n")
    try out.write("  install owner/name[@version]   download, build and install a tool or application\n")
    try out.write("  list                   what is installed\n")
    try out.write("  uninstall <name>       remove it\n\n")
    try out.write("Other\n")
    try out.write("  update                 reinstall the latest luce, luce-base and luc\n")
    try out.write("  --version, help\n")

