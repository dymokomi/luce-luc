#==============================================================================================
#
#   luc - The Luce project tool
#
#   DESCRIPTION:
#       One command for a Luce project: build, run, test, check and format it through the Luce
#       compiler, and run the named workflows in its luce.toml `[tasks]`. luc finds the project
#       by walking up to the nearest luce.toml, picks the compiler from the package language
#       (luce-base or luce, overridable with LUCE_BASE / LUCE), and forwards the compiler's own
#       output and exit code. This is the MVP surface; scaffolding, dependencies, task
#       dependency graphs and workspaces follow (see README).
#
#==============================================================================================

import c
import io
import os
import files
import paths
import platform
import process
import strings
import memory
import pkg
import luc.remote as remote
import luc.release_upload as release_upload
import luc.release_download as release_download
import luc.pack_check as pack_check
import luc.catalog as catalog
import luc.graph_lock as graph_lock
import luc.locked_release as locked_release
import luc.graph_sync as graph_sync
import luc.credentials as credentials
import luc.pull_requests as pull_requests
import luc.checkout as checkout
import luc.project_file as project_file
import git
import crypto_native

## The luc version, kept in step with VERSION.
pub let luc_version: str = "0.14.0"

## The only registry account for now; `luc init` writes it as the package owner.
let default_owner = "dymokomi"

## A command-line or manifest problem the user can fix.
pub let usage_error: ErrorCode = ErrorCode.package(1)

# A scratch buffer for one interpolated error message at a time (errors are terminal).
var message_buffer: u8[512]

# mark: The project ===========================================================================

## One `[tasks]` workflow: its name, the shell command it runs, an optional one-line
## description, and the tasks it depends on (run first).
struct Task:
    var name: str
    var command: str
    var description: str
    var depends: str[]

## A loaded luce.toml: where it is, the package identity, the chosen entry, and its tasks.
struct Project:
    var root: str
    var name: str
    var language: str
    var entry: str
    var tasks: Task[]
    var task_count: usize

    mutating func close():
        strings.release(self.root)
        strings.release(self.name)
        strings.release(self.language)
        strings.release(self.entry)
        for i in 0..<self.task_count:
            strings.release(self.tasks[i].name)
            strings.release(self.tasks[i].command)
            strings.release(self.tasks[i].description)
            for dependency in self.tasks[i].depends: strings.release(dependency)
            if self.tasks[i].depends.length > 0: free(self.tasks[i].depends) in memory.heap
        if self.tasks.length > 0: free(self.tasks) in memory.heap
        self.task_count = 0

    ## The compiler for this project's language, overridable through the environment.
    func compiler() -> str!:
        let variable = "LUCE" if self.language == "luce" else "LUCE_BASE"
        if let chosen = os.env((c.str)variable):
            return chosen
        return "luce" if self.language == "luce" else "luce-base"

    ## The entry source: the manifest's `entry`, else the conventional app main, else the
    ## package's own library module (src/<name>/<name>.<ext>) so `check` works on a package.
    func entry_path() -> str!:
        if self.entry.length > 0:
            return try paths.join(self.root, self.entry)
        let suffix = ".luc" if self.language == "luce" else ".lucb"
        let main_name = try join_name("main", suffix)
        defer strings.release(main_name)
        let identifier = try project_file.module_name(self.name)
        defer strings.release(identifier)
        let module_name = try join_name(identifier, suffix)
        defer strings.release(module_name)
        let module_directory = try paths.join("src", identifier)
        defer strings.release(module_directory)
        let module = try paths.join(module_directory, module_name)
        defer strings.release(module)
        let application = try paths.join("src", main_name)
        defer strings.release(application)
        for relative in [application, main_name, module]:
            let candidate = try paths.join(self.root, relative)
            let terminated = try strings.copy(candidate)
            let exists = files.exists((c.str)terminated)
            strings.release(terminated)
            if exists: return candidate
            strings.release(candidate)
        error(usage_error, "no entry source found (expected src/main or src/<name>/<name>); set entry in package.prisma")

    func find_task(name: str) -> Task?:
        var index: usize = 0
        while index < self.task_count:
            if self.tasks[index].name == name:
                return self.tasks[index]
            index += 1
        return none

# mark: Loading luce.toml ======================================================================

## Find the nearest package.prisma from the current directory upward, load it, and
## regenerate the luce.toml the compilers read. Absent one, the project is an anonymous
## luce-base app rooted at the current directory.
func load_project() -> Project!:
    let start = try os.cwd()
    defer strings.release(start)
    var project = Project(root = try strings.copy(start), name = try strings.copy("app"),
        language = try strings.copy("luce-base"), entry = try strings.copy(""))
    errdefer project.close()
    project.tasks = try alloc Task[128]
    var directory = start
    while true:
        if try project_file.exists_in(directory):
            strings.release(project.root)
            project.root = try strings.copy(directory)
            try apply_definition(&project)
            try project_file.generate(project.root)
            return project
        let parent = paths.directory(directory)
        if parent == directory or parent.length == 0:
            return project
        directory = parent

func apply_definition(project: Project*) -> !:
    var definition = try project_file.read(project.root)
    defer definition.close()
    try replace_text(&project.name, definition.name)
    try replace_text(&project.language, definition.language)
    try replace_text(&project.entry, definition.entry)
    for i in 0..<definition.task_count:
        let declared = try definition.task_at(i)
        let slot = try task_slot(project, declared.name)
        try replace_text(&project.tasks[slot].command, declared.command)
        try replace_text(&project.tasks[slot].description, declared.description)
        var depends: str[]
        for j in 0..<declared.depend_count:
            depends = try append(depends, try strings.copy(declared.depends[j]))
        project.tasks[slot].depends = depends

## Parse the little of luce.toml luc needs: [package] name/language/entry and [tasks]
## name = "command" pairs. Values are quoted strings; comments and blank lines are ignored.
func parse_manifest(project: Project*, text: str) -> !:
    var section = ""
    let lines = try strings.split(text, '\n')
    defer free(lines) in memory.heap
    for raw in lines:
        let line = strings.trim(raw)
        if line.length == 0 or strings.starts_with(line, "#"):
            continue
        if strings.starts_with(line, "["):
            section = strings.trim(strip(line, "[", "]"))
            continue
        let (key_raw, value_raw) = strings.split_once(line, "=") else continue
        let key = strings.trim(key_raw)
        let value = unquote(strings.trim(value_raw))
        if section == "package":
            if key == "name":
                try replace_text(&project.name, value)
            elif key == "language":
                try replace_text(&project.language, value)
            elif key == "entry":
                try replace_text(&project.entry, value)
        elif section == "tasks":
            let slot = try task_slot(project, key)
            try replace_text(&project.tasks[slot].command, value)
        elif strings.starts_with(section, "tasks."):
            let slot = try task_slot(project, (str)section.bytes[6..])
            if key == "cmd":
                try replace_text(&project.tasks[slot].command, value)
            elif key == "description":
                try replace_text(&project.tasks[slot].description, value)
            elif key == "depends":
                let replacement = try string_array(value)
                for dependency in project.tasks[slot].depends: strings.release(dependency)
                if project.tasks[slot].depends.length > 0: free(project.tasks[slot].depends) in memory.heap
                project.tasks[slot].depends = replacement

func replace_text(target: str*, value: str) -> !:
    let replacement = try strings.copy(value)
    strings.release(*target)
    *target = replacement

func unquote(text: str) -> str:
    if text.length >= 2 and strings.starts_with(text, "\"") and strings.ends_with(text, "\""):
        return (str)text.bytes[1..<text.length - 1]
    return text

func strip(text: str, open: str, close: str) -> str:
    var inner = text
    if strings.starts_with(inner, open):
        inner = (str)inner.bytes[open.length..]
    if strings.ends_with(inner, close):
        inner = (str)inner.bytes[..<inner.length - close.length]
    return inner

## The index of the task named `name`, creating an empty one when it is new; a task can be
## introduced by a plain [tasks] line or a [tasks.<name>] subtable, in any order.
func task_slot(project: Project*, name: str) -> usize!:
    var index: usize = 0
    while index < project.task_count:
        if project.tasks[index].name == name:
            return index
        index += 1
    if project.task_count >= project.tasks.length:
        error(usage_error, "too many tasks in luce.toml")
    let owned_name = try strings.copy(name)
    errdefer strings.release(owned_name)
    let command = try strings.copy("")
    errdefer strings.release(command)
    let description = try strings.copy("")
    errdefer strings.release(description)
    project.tasks[project.task_count] = Task(name = owned_name, command = command, description = description)
    project.task_count += 1
    return project.task_count - 1

## Parse a `["a", "b"]` TOML string array into a slice; empty items are dropped.
func string_array(value: str) -> str[]!:
    let inner = strip(strings.trim(value), "[", "]")
    var result: str[]
    let parts = try strings.split(inner, ',')
    defer free(parts) in memory.heap
    for part in parts:
        let item = unquote(strings.trim(part))
        if item.length > 0:
            result = try append(result, try strings.copy(item))
    return result

# mark: Running things =========================================================================

## Run `program` with `arguments`, forwarding its output and returning its exit code. Dynamic
## strings become NUL-terminated copies so they cross the process boundary as `c.str`.
func spawn(program: str, arguments: str[]) -> i32!:
    let program_text = try strings.copy(program)
    defer strings.release(program_text)
    let argv = try alloc c.str[arguments.length]
    var index: usize = 0
    defer release_spawn_arguments(argv, index)
    while index < arguments.length:
        argv[index] = (c.str)try strings.copy(arguments[index])
        index += 1
    let (status, out, err) = try process.run((c.str)program_text, argv)
    defer process.release(out)
    defer process.release(err)
    if out.length > 0:
        try io.stdout().write(out)
    if err.length > 0:
        try io.stderr().write(err)
    return status

func release_spawn_arguments(arguments: c.str[], count: usize):
    for i in 0..<count: strings.release((str)arguments[i])
    if arguments.length > 0: free(arguments) in memory.heap

## The project's build output path, build/<name> under its root.
func output_path(project: Project*) -> str!:
    let directory = try paths.join(project.root, "build")
    defer strings.release(directory)
    return try paths.join(directory, project.name)

## Build the project's entry into build/<name> under the project root.
func build(project: Project*, release: bool, extra: str[]) -> i32!:
    let entry = try project.entry_path()
    defer strings.release(entry)
    try ensure_build(project)
    let output = try output_path(project)
    defer strings.release(output)
    var arguments: str[]
    defer release_string_array(arguments)
    for word in ["build", entry, "--native", "-o", output]:
        arguments = try append(arguments, word)
    if release:
        arguments = try append(arguments, "--release")
    let combined = try concat(arguments, extra)
    defer release_string_array(combined)
    return try spawn(try project.compiler(), combined)

func ensure_build(project: Project*) -> !:
    let directory = try paths.join(project.root, "build")
    defer strings.release(directory)
    let terminated = try strings.copy(directory)
    defer strings.release(terminated)
    if not files.exists((c.str)terminated):
        try files.create_directory((c.str)terminated)

## Build, then run the produced binary with `arguments`.
func run_app(project: Project*, release: bool, arguments: str[]) -> i32!:
    var no_extra: str[]
    let status = try build(project, release, no_extra)
    if status != 0:
        return status
    let executable = try output_path(project)
    defer strings.release(executable)
    return try spawn(executable, arguments)

## A task run in progress: the tasks already finished (each runs once) and the tasks on the
## current dependency chain (to catch a cycle).
struct Runner:
    var project: Project*
    var done: str[]
    var done_count: usize
    var active: str[]
    var active_count: usize

## Run task `name`, its `depends` first (each at most once), forwarding `passthrough` only to
## the named target. Fails on an unknown task or a dependency cycle.
func run_task(project: Project*, name: str, passthrough: str[]) -> i32!:
    var runner = Runner(project = project)
    runner.done = try alloc str[project.task_count + 1]
    runner.active = try alloc str[project.task_count + 1]
    return try run_graph(&runner, name, passthrough, true)

func run_graph(runner: Runner*, name: str, passthrough: str[], target: bool) -> i32!:
    var index: usize = 0
    while index < runner.done_count:
        if runner.done[index] == name:
            return 0
        index += 1
    index = 0
    while index < runner.active_count:
        if runner.active[index] == name:
            error(usage_error, try format(message_buffer[0..], f"task dependency cycle at '{name}'"))
        index += 1
    let task = runner.project.find_task(name) else error(usage_error, try format(message_buffer[0..], f"no task named '{name}'"))
    runner.active[runner.active_count] = name
    runner.active_count += 1
    for dependency in task.depends:
        var none_args: str[]
        let dependency_status = try run_graph(runner, dependency, none_args, false)
        if dependency_status != 0:
            return dependency_status
    var args: str[]
    if target:
        args = passthrough
    let status = try run_command(task.command, args)
    runner.active_count -= 1
    runner.done[runner.done_count] = name
    runner.done_count += 1
    return status

## Run a task's command through the host's shell (so `&&`, pipes and redirects work),
## forwarding `args`. POSIX uses `sh -c`, Windows uses `cmd /c`, so tasks run on either.
func run_command(command: str, args: str[]) -> i32!:
    if platform.windows:
        # cmd has no `$@`; append the arguments to the command line, space separated.
        var windows: str[]
        windows = try append(windows, "/c")
        windows = try append(windows, try join_with(command, args))
        return try spawn("cmd", windows)
    # sh -c "<command> \"$@\"" sh <args>: the args become $1.. so "$@" forwards them.
    var script = command
    if args.length > 0:
        var buffer: u8[2048]
        script = try strings.copy(try format(buffer[0..], f"{command} \"$@\""))
    var argv: str[]
    for word in ["-c", script, "sh"]:
        argv = try append(argv, word)
    return try spawn("sh", try concat(argv, args))

## `command` followed by each argument, space separated, as one command line.
func join_with(command: str, args: str[]) -> str!:
    var parts: str[]
    parts = try append(parts, command)
    return try strings.join(try concat(parts, args), " ")

## A two-word argument list as a slice (fixed-size literals do not coerce to `str[]`).
func two(first: str, second: str) -> str[]!:
    var result: str[]
    result = try append(result, first)
    result = try append(result, second)
    return result

func list_tasks(project: Project*) -> !:
    if project.task_count == 0:
        try io.stdout().write("no tasks are defined in luce.toml\n")
        return
    try io.stdout().write("tasks:\n")
    var index: usize = 0
    while index < project.task_count:
        let task = project.tasks[index]
        if task.description.length > 0:
            try io.stdout().write(f"  {task.name}  -  {task.description}\n")
        else:
            try io.stdout().write(f"  {task.name}\n")
        index += 1

# mark: Dependencies ==========================================================================

func read_release_file(path: str, limit: usize) -> u8[]!:
    let filename = try strings.copy(path)
    defer strings.release(filename)
    return try files.read_limit((c.str)filename, limit)

## os.cwd returns an allocator-owned buffer, not a strings.copy allocation.
## Capture it in a short-lived arena and return a normal owned string.
func owned_cwd() -> str!:
    var scratch = try memory.Arena.over(memory.heap, 8192)
    defer scratch.destroy()
    with scratch:
        let directory = try os.cwd()
        with memory.heap:
            return try strings.copy(directory)

func read_project_lock() -> u8[]!:
    let start = try owned_cwd()
    defer strings.release(start)
    var directory = start
    while true:
        let manifest = try paths.join(directory, "luce.toml")
        defer strings.release(manifest)
        if files.exists((c.str)manifest):
            let filename = try paths.join(directory, "luc.lock")
            defer strings.release(filename)
            return try files.read_limit((c.str)filename, 1048576)
        let parent = paths.directory(directory)
        if parent == directory or parent.length == 0:
            error(usage_error, "not in a Luce project (no luce.toml found)")
        directory = parent

## Bind a verified release and the exact key that verified it to the project lock.
func require_locked_release(release: pkg.Release, publisher_key_digest: const u8[]) -> u8!:
    let contents = try read_project_lock()
    defer free(contents) in memory.heap
    var lock = try pkg.decode_lock((str)contents)
    defer lock.close()
    return try locked_release.require(&lock, release, publisher_key_digest)

## Verify exact local release bytes against an explicitly supplied trusted public key.
## This does not establish key ownership or authorize installation.
func verify_release_command(own: str[], passthrough: str[]) -> i32!:
    let locked = own.length == 5 and own[4] == "--locked"
    if (own.length != 4 and not locked) or passthrough.length != 0:
        error(usage_error, "usage: luc verify-release <metadata> <signature> <trusted-key> <source> [--locked]")
    let wire = try read_release_file(own[0], pkg.max_release_metadata)
    defer free(wire) in memory.heap
    let signature = try read_release_file(own[1], 3309)
    defer free(signature) in memory.heap
    let key = try read_release_file(own[2], 1952)
    defer free(key) in memory.heap
    let source = try read_release_file(own[3], 67108864)
    defer free(source) in memory.heap
    let release = try pkg.decode_release(wire)
    if not try pkg.verify_release(release, key, signature, source):
        error(usage_error, "release signature or source digest verification failed")
    if locked:
        var key_digest: u8[32]
        discard(try crypto_native.digest(key, key_digest, "sha256"))
        let schema = try require_locked_release(release, key_digest)
        if schema == 3: try io.stdout().write("release matches graph-complete luc.lock v3 including publisher key\n")
        elif schema == 2: try io.stdout().write("release matches luc.lock v2 including commit and toolchain pins\n")
        else: try io.stdout().write("release matches luc.lock (commit and toolchain are not pinned by lock v1)\n")
    try io.stdout().write(f"verified {release.package}@{release.version} against supplied key (origin ownership not verified)\n")
    return 0

## Verify and materialize the same retained source bytes: never reopen a path
## between signature verification and checkout. Trust in the key is caller-supplied.
func checkout_release_command(own: str[]) -> i32!:
    let locked = own.length == 6 and own[5] == "--locked"
    if own.length != 5 and not locked:
        error(usage_error, "usage: luc checkout-release <metadata> <signature> <trusted-key> <pack> <new-directory> [--locked]")
    let wire = try read_release_file(own[0], pkg.max_release_metadata)
    defer free(wire) in memory.heap
    let signature = try read_release_file(own[1], 3309)
    defer free(signature) in memory.heap
    let key = try read_release_file(own[2], 1952)
    defer free(key) in memory.heap
    let source = try read_release_file(own[3], 67108864)
    defer free(source) in memory.heap
    let release = try pkg.decode_release(wire)
    if not try pkg.verify_release(release, key, signature, source):
        error(usage_error, "release signature or source digest verification failed")
    if locked:
        var key_digest: u8[32]
        discard(try crypto_native.digest(key, key_digest, "sha256"))
        discard(try require_locked_release(release, key_digest))
    var commit: u8[20]
    try git.decode_id(release.commit, commit)
    var pack = try git.decode_pack(source)
    defer pack.close()
    for byte in own[4].bytes:
        if byte == 0: error(usage_error, "invalid checkout destination")
    if own[4].length == 0: error(usage_error, "empty checkout destination")
    try checkout.materialize(&pack, commit, own[4])
    try io.stdout().write("checked out release verified against supplied key (origin ownership and freshness not verified)\n")
    return 0

## Parse the entire pinned lock profile without changing the project or fetching.
## This is structural validation, not release-signature or cache verification.
func lock_command(project: Project*, own: str[], passthrough: str[]) -> i32!:
    if passthrough.length != 0: error(usage_error, "lock does not accept passthrough arguments")
    let manifest = try require_manifest(project)
    defer strings.release(manifest)
    if own.length == 1 and own[0] == "--check":
        let path = try paths.join(project.root, "luc.lock")
        defer strings.release(path)
        let filename = try strings.copy(path)
        defer strings.release(filename)
        let contents = try files.read_limit((c.str)filename, 1048576)
        defer free(contents) in memory.heap
        var lock = try pkg.decode_lock((str)contents)
        defer lock.close()
        try io.stdout().write(f"valid luc.lock syntax: {lock.count} packages (signatures not verified)\n")
        return 0
    if own.length == 6 and own[1] == "--trusted-key" and own[3] == "--vault" and own[5] == "--password-stdin":
        return try graph_lock.generate(project.root, manifest, own[0], own[2], own[4])
    error(usage_error, "usage: luc lock --check | luc lock <origin> --trusted-key <key> --vault <session> --password-stdin")

func strict_directory(path: str, permissions: u32) -> !:
    let name = try strings.copy(path)
    defer strings.release(name)
    let info = files.metadata((c.str)name, follow_symlinks = false) catch failure:
        if failure.code != files.missing: error(failure.code, failure.message)
        files.create_directory((c.str)name, permissions) catch create_failure:
            if create_failure.code != files.already_exists: error(create_failure.code, create_failure.message)
        recover try files.metadata((c.str)name, follow_symlinks = false)
    if info.kind != files.FileKind.directory: error(usage_error, "package cache path is not a directory")

func install_identity(origin: str, package: str, version: str, output: u8[]) -> str!:
    var input: u8[512]
    let value = try format(input, f"{origin}\n{package}\n{version}")
    var digest: u8[32]
    discard(try crypto_native.digest(value.bytes, digest, "sha256"))
    if output.length < 64: error(usage_error, "package cache identity output too small")
    let digits = b"0123456789abcdef"
    for i in 0..<digest.length:
        output[i * 2] = digits[digest[i] >> 4]
        output[i * 2 + 1] = digits[digest[i] & 15]
    return (str)output[..<64]

func cleanup_install(path: str, keep: bool*):
    if not *keep: discard(files.remove_tree((c.str)path) catch: recover ())

## Install a verified exact release as an ordinary local manifest dependency.
## Online writes the immutable artifact cache; offline never opens credentials/network.
func install_command(project: Project*, own: str[]) -> i32!:
    let online = (own.length == 8 or own.length == 9) and own[3] == "--trusted-key" and own[5] == "--vault" and own[7] == "--password-stdin"
    let offline = (own.length == 6 or own.length == 7) and own[3] == "--trusted-key" and own[5] == "--offline"
    if not online and not offline:
        error(usage_error, "usage: luc install <origin> <owner/package> <version> --trusted-key <key> (--vault <session> --password-stdin | --offline) [--locked]")
    let locked = (online and own.length == 9 and own[8] == "--locked") or (offline and own.length == 7 and own[6] == "--locked")
    if ((online and own.length == 9) or (offline and own.length == 7)) and not locked:
        error(usage_error, "the only trailing install option is --locked")
    let manifest = try require_manifest(project)
    defer strings.release(manifest)
    let origin = own[0]
    let package = own[1]
    let version = own[2]
    let key = own[4]
    try release_download.validate_request(origin, package, version)
    var encoded: u8[64]
    let identity = try install_identity(origin, package, version, encoded)
    let state = try paths.join(project.root, ".luc")
    defer strings.release(state)
    try strict_directory(state, 448)
    let packages = try paths.join(state, "packages")
    defer strings.release(packages)
    try strict_directory(packages, 448)
    let default_cache = try paths.join(state, "cache")
    defer strings.release(default_cache)
    let cache = try strings.copy(os.env((c.str)"LUC_PACKAGE_CACHE") else default_cache)
    defer strings.release(cache)
    if cache.length == 0: error(usage_error, "LUC_PACKAGE_CACHE must not be empty")
    try strict_directory(cache, 448)
    var artifact_name_buffer: u8[96]
    let artifact_name = try format(artifact_name_buffer, f"release-{identity}.lrp1")
    let artifact = try paths.join(cache, artifact_name)
    defer strings.release(artifact)
    var downloaded: release_download.Download
    if offline:
        downloaded = try release_download.load_cache(artifact, origin, package, version, key)
    else:
        downloaded = try release_download.fetch(origin, package, version, key, own[6])
        if files.exists((c.str)artifact):
            var cached = try release_download.load_cache(artifact, origin, package, version, key)
            defer cached.close()
            if not release_download.same(&downloaded, &cached): error(usage_error, "cached release differs from immutable registry release")
        else:
            release_download.save_cache(&downloaded, artifact) catch failure:
                if failure.code != files.already_exists: error(failure.code, failure.message)
                var raced = try release_download.load_cache(artifact, origin, package, version, key)
                defer raced.close()
                if not release_download.same(&downloaded, &raced): error(usage_error, "concurrent cache publication differs from registry release")
    defer downloaded.close()
    let release = try pkg.decode_release(downloaded.metadata[..<downloaded.metadata_size])
    if locked: discard(try require_locked_release(release, downloaded.publisher_key_digest))
    var commit: u8[20]
    try git.decode_id(release.commit, commit)
    var pack = try git.decode_pack(downloaded.source[..<downloaded.source_size])
    defer pack.close()
    var install_name_buffer: u8[96]
    let install_name = try format(install_name_buffer, f"release-{identity}")
    let destination = try paths.join(packages, install_name)
    defer strings.release(destination)
    try checkout.materialize(&pack, commit, destination)
    var keep = false
    errdefer cleanup_install(destination, &keep)
    let dependency_manifest = try paths.join(destination, "luce.toml")
    defer strings.release(dependency_manifest)
    if not files.exists((c.str)dependency_manifest):
        error(usage_error, "installed release has no root luce.toml")
    let dependency = try package_name_at(dependency_manifest)
    defer strings.release(dependency)
    var probe = Project(root = try strings.copy(destination), name = try strings.copy(""),
        language = try strings.copy("luce-base"), entry = try strings.copy(""))
    probe.tasks = try alloc Task[1]
    defer probe.close()
    let dependency_name = try strings.copy(dependency_manifest)
    defer strings.release(dependency_name)
    let dependency_text = try files.read((c.str)dependency_name)
    defer free(dependency_text) in memory.heap
    try parse_manifest(&probe, (str)dependency_text)
    if probe.language != release.compiler:
        error(usage_error, "installed manifest language does not match signed release compiler")
    var relative_buffer: u8[128]
    let relative = try format(relative_buffer, f".luc/packages/{install_name}")
    try upsert_dependency(manifest, dependency, relative)
    keep = true
    let mode = "offline cache" if offline else "registry and verified cache"
    try io.stdout().write(f"installed {package}@{version} as {dependency} from {mode}\n")
    return 0

## `luc add <path>` (or `luc add <name> <path>`) records a local package dependency in
## luce.toml. The dependency's own luce.toml gives its name, which Base requires the key to
## match; the value is the path, relative to this manifest, to that package's directory.
func add_command(project: Project*, own: str[]) -> i32!:
    let manifest = try require_manifest(project)
    strings.release(manifest)
    var location = ""
    for word in own:
        if not strings.starts_with(word, "--"): location = word
    if location.length == 0:
        error(usage_error, "luc add needs a path: luc add <path-to-package>")
    let name = try project_file.add_dependency(project.root, location)
    defer strings.release(name)
    try project_file.generate(project.root)
    try io.stdout().write(f"added dependency {name} from {location}\n")
    return 0

## `luc remove <name>` drops a dependency from package.prisma.
func remove_command(project: Project*, own: str[]) -> i32!:
    let manifest = try require_manifest(project)
    strings.release(manifest)
    var name = ""
    for word in own:
        if not strings.starts_with(word, "--"):
            name = word
            break
    if name.length == 0:
        error(usage_error, "luc remove needs a name: luc remove <name>")
    if not try project_file.remove_dependency(project.root, name):
        try io.stderr().write(f"luc: no dependency named '{name}'\n")
        return 1
    try project_file.generate(project.root)
    try io.stdout().write(f"removed dependency {name}\n")
    return 0

## `luc clean` removes the project's build/ directory (binary and cache); `luc clean cache`
## removes only build/.cache, keeping the built binary.
func clean_command(project: Project*, own: str[]) -> i32!:
    let manifest = try require_manifest(project)
    strings.release(manifest)
    var target = try paths.join(project.root, "build")
    var label = "build"
    if own.length > 0 and own[0] == "cache":
        target = try paths.join(target, ".cache")
        label = "build/.cache"
    let terminated = try strings.copy(target)
    if not files.exists((c.str)terminated):
        try io.stdout().write(f"nothing to clean ({label} is not present)\n")
        return 0
    try files.remove_tree((c.str)terminated)
    try io.stdout().write(f"removed {target}\n")
    return 0

## This project's generated luce.toml, or a usage error when there is no project here.
func require_manifest(project: Project*) -> str!:
    if not try project_file.exists_in(project.root):
        error(usage_error, "not in a Luce project (no package.prisma found); run 'luc init' first")
    return try paths.join(project.root, "luce.toml")

func package_name_at(manifest: str) -> str!:
    var probe = Project(root = try strings.copy(""), name = try strings.copy(""),
        language = try strings.copy("luce-base"), entry = try strings.copy(""))
    probe.tasks = try alloc Task[1]
    defer probe.close()
    let filename = try strings.copy(manifest)
    defer strings.release(filename)
    let contents = try files.read((c.str)filename)
    defer free(contents) in memory.heap
    try parse_manifest(&probe, (str)contents)
    if probe.name.length == 0:
        error(usage_error, try format(message_buffer[0..], f"the package at {manifest} has no [package] name"))
    if probe.name.length > 128: error(usage_error, "dependency package name is too long")
    for i in 0..<probe.name.length:
        let byte = probe.name.bytes[i]
        let letter = byte >= 'a' and byte <= 'z'
        if not letter and byte != '_' and (i == 0 or byte < '0' or byte > '9'):
            error(usage_error, "dependency package name must be a lowercase identifier")
    return try strings.copy(probe.name)

func release_string_array(values: str[]):
    if values.length > 0: free(values) in memory.heap

## Add or replace `name = "value"` under `[dependencies]`, creating the section if absent,
## and preserving the rest of the file line for line.
func upsert_dependency(manifest: str, name: str, value: str) -> !:
    let entry = try toml_line(name, value)
    defer strings.release(entry)
    let filename = try strings.copy(manifest)
    defer strings.release(filename)
    let contents = try files.read((c.str)filename)
    defer free(contents) in memory.heap
    let text = (str)contents
    var result: str[]
    defer release_string_array(result)
    var section = ""
    var has_section = false
    let lines = try strings.split(text, '\n')
    defer free(lines) in memory.heap
    for raw in lines:
        let trimmed = strings.trim(raw)
        if strings.starts_with(trimmed, "["):
            section = trimmed
            result = try append(result, raw)
            if trimmed == "[dependencies]":
                has_section = true
                result = try append(result, entry)
            continue
        if section == "[dependencies]" and dependency_key(trimmed) == name:
            continue
        result = try append(result, raw)
    if not has_section:
        result = try append(result, "[dependencies]")
        result = try append(result, entry)
        result = try append(result, "")
    let joined = try strings.join(result, "\n")
    defer strings.release(joined)
    try files.write_text(manifest, joined)

## Remove `name = ...` under `[dependencies]`; answers whether a line was removed.
func remove_dependency(manifest: str, name: str) -> bool!:
    let filename = try strings.copy(manifest)
    defer strings.release(filename)
    let contents = try files.read((c.str)filename)
    defer free(contents) in memory.heap
    let text = (str)contents
    var result: str[]
    defer release_string_array(result)
    var section = ""
    var removed = false
    let lines = try strings.split(text, '\n')
    defer free(lines) in memory.heap
    for raw in lines:
        let trimmed = strings.trim(raw)
        if strings.starts_with(trimmed, "["):
            section = trimmed
            result = try append(result, raw)
            continue
        if section == "[dependencies]" and dependency_key(trimmed) == name:
            removed = true
            continue
        result = try append(result, raw)
    if removed:
        let joined = try strings.join(result, "\n")
        defer strings.release(joined)
        try files.write_text(manifest, joined)
    return removed

## The key of a `key = value` line, or empty for anything else.
func dependency_key(line: str) -> str:
    if line.length == 0 or strings.starts_with(line, "#"):
        return ""
    let (key, _) = strings.split_once(line, "=") else return ""
    return strings.trim(key)

func toml_line(key: str, value: str) -> str!:
    var buffer: u8[1024]
    return try strings.copy(try format(buffer[0..], f"{key} = \"{value}\""))

# mark: Updating the toolchain ================================================================

## `luc update` (alias `upgrade`) reinstalls the latest luc + luce-base + luce by re-running
## the official installers from luciaos.com. luc ships inside the luce-base release, so
## updating luce-base updates luc too. `--dry-run` prints the commands without running them.
func update_command(own: str[]) -> i32!:
    let dry = has(own, "--dry-run")
    var failed = false
    for site in ["luce-base", "luce"]:
        let command = try installer_command(site)
        if dry:
            try io.stdout().write(f"{command}\n")
        else:
            try io.stdout().write(f"==> updating {site} from https://{site}.luciaos.com\n")
            if try run_shell(command) != 0:
                try io.stderr().write(f"luc: updating {site} did not complete\n")
                failed = true
    return 1 if failed else 0

## The one-line installer pipeline for a site: curl|sh on POSIX, irm|iex on Windows.
func installer_command(site: str) -> str!:
    var buffer: u8[512]
    if platform.windows:
        return try strings.copy(try format(buffer[0..], f"irm https://{site}.luciaos.com/install.ps1 | iex"))
    return try strings.copy(try format(buffer[0..], f"curl -fsSL https://{site}.luciaos.com/install.sh | sh"))

## Run a shell pipeline through the host shell.
func run_shell(command: str) -> i32!:
    if platform.windows:
        var windows: str[]
        for word in ["-NoProfile", "-Command", command]:
            windows = try append(windows, word)
        return try spawn("powershell", windows)
    return try spawn("sh", try two("-c", command))

# mark: Scaffolding ===========================================================================

## `luc new <path>` creates a project in a new directory; `luc init` in the current one.
## Flags: --package (a library) or --app (default); --luce or --luce-base (default).
func scaffold_command(command: str, own: str[]) -> i32!:
    let is_package = has(own, "--package") or has(own, "--lib")
    let language = "luce" if has(own, "--luce") else "luce-base"
    var target = try os.cwd()
    if command == "new":
        var chosen = ""
        for word in own:
            if not strings.starts_with(word, "--"):
                chosen = word
        if chosen.length == 0:
            error(usage_error, "luc new needs a path: luc new <dir>")
        target = chosen
    let name = paths.base(target)
    if try project_file.exists_in(target):
        error(usage_error, "a package.prisma already exists here; refusing to overwrite it")
    try scaffold(target, name, language, is_package)
    let kind = "package" if is_package else "application"
    try io.stdout().write(f"created {language} {kind} '{name}' in {target}\n")
    return 0

## Write the project's directories and starter files.
func scaffold(target: str, name: str, language: str, is_package: bool) -> !:
    try ensure_dir(target)
    let source = try paths.join(target, "src")
    try ensure_dir(source)
    let suffix = ".luc" if language == "luce" else ".lucb"
    var definition: u8[1024]
    try write_file(try paths.join(target, project_file.file_name), try project_file.scaffold(name, default_owner, language, is_package, definition))
    try write_file(try paths.join(target, ".gitignore"), "build/\n.luc/\nluce.toml\n")
    if is_package:
        # A package may be named luce-json; its module is the identifier luce_json.
        let module = try project_file.module_name(name)
        defer strings.release(module)
        let module_dir = try paths.join(source, module)
        try ensure_dir(module_dir)
        try write_file(try paths.join(module_dir, try join_name(module, suffix)), try library_source(module, language))
    else:
        try write_file(try paths.join(source, try join_name("main", suffix)), try program_source(name, language))

func ensure_dir(path: str) -> !:
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    if not files.exists((c.str)terminated):
        try files.create_directory((c.str)terminated)

func write_file(path: str, content: str) -> !:
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    try files.write((c.str)terminated, content.bytes)

func join_name(stem: str, suffix: str) -> str!:
    var buffer: u8[128]
    return try strings.copy(try format(buffer[0..], f"{stem}{suffix}"))

func program_source(name: str, language: str) -> str!:
    var buffer: u8[512]
    if language == "luce":
        return try strings.copy(try format(buffer[0..], f"pub func main(arguments: list[str]) -> int!:\n    print(\"hello from {name}\")\n    return 0\n"))
    return try strings.copy(try format(buffer[0..], f"pub func main(arguments: str[]) -> i32:\n    print(\"hello from {name}\")\n    return 0\n"))

func library_source(name: str, language: str) -> str!:
    var buffer: u8[512]
    return try strings.copy(try format(buffer[0..], f"## The {name} package.\npub func greeting() -> str:\n    return \"hello from {name}\"\n"))

# mark: The command line =======================================================================

func append(items: str[], value: str) -> str[]!:
    let grown = try alloc str[items.length + 1]
    var index: usize = 0
    while index < items.length:
        grown[index] = items[index]
        index += 1
    grown[items.length] = value
    if items.length > 0: free(items) in memory.heap
    return grown

func concat(left: str[], right: str[]) -> str[]!:
    let grown = try alloc str[left.length + right.length]
    var index: usize = 0
    while index < left.length:
        grown[index] = left[index]
        index += 1
    var offset: usize = 0
    while offset < right.length:
        grown[left.length + offset] = right[offset]
        offset += 1
    return grown

## Split the arguments after the command into its own words and the passthrough after `--`.
func partition(arguments: c.str[], start: usize) -> (str[], str[])!:
    var own: str[]
    var passthrough: str[]
    var index = start
    var seen_dashes = false
    while index < arguments.length:
        let word = (str)arguments[index]
        if word == "--" and not seen_dashes:
            seen_dashes = true
        elif seen_dashes:
            passthrough = try append(passthrough, word)
        else:
            own = try append(own, word)
        index += 1
    return (own, passthrough)

func has(words: str[], flag: str) -> bool:
    for word in words:
        if word == flag:
            return true
    return false

func require_new_publish_artifact(destination: str) -> !:
    if destination.length == 0 or destination.length > 4096: error(usage_error, "invalid artifact destination")
    for byte in destination.bytes:
        if byte == 0: error(usage_error, "invalid artifact destination")
    let basename = paths.base(destination)
    if basename.length == 0 or basename == "." or basename == "..": error(usage_error, "invalid artifact filename")
    let filename = try strings.copy(destination)
    defer strings.release(filename)
    var exists = true
    discard(files.metadata((c.str)filename, follow_symlinks = false) catch failure:
        if failure.code != files.missing: error(failure.code, failure.message)
        exists = false
        recover files.Metadata())
    if exists: error(usage_error, "artifact destination already exists")

## Publish one exact commit already advertised by the registry. Metadata is
## derived from that remote graph's root luce.toml, never the working tree.
func publish_command(origin: str, package: str, version: str, commit: str,
                     toolchain: str, artifact: str, session_vault: str,
                     key_vault: str) -> i32!:
    try release_download.validate_request(origin, package, version)
    discard(try pkg.parse_version(toolchain))
    var requested: u8[20]
    try git.decode_id(commit, requested)
    try require_new_publish_artifact(artifact)
    var split: usize = 0
    while split < package.length and package.bytes[split] != '/': split += 1
    if split == 0 or split == package.length: error(usage_error, "invalid package identity")
    let account = (str)package.bytes[..<split]
    var incoming: u8[2051]
    defer crypto_native.wipe(incoming)
    let (session_password, key_password) = try credentials.password_pair(incoming)
    var session = try credentials.load_password(session_vault, session_password, origin, account)
    defer session.close()
    var seed = try credentials.signing_seed_password(key_vault, key_password, origin, account)
    defer seed.close()
    var url_buffer: u8[384]
    let url = try format(url_buffer, f"{origin}/git/{package}")
    let source_storage = try alloc u8[67108864] in memory.heap
    defer free(source_storage) in memory.heap
    let source_size = try remote.fetch_into(url, commit, try session.bytes(), source_storage)
    let source = source_storage[..<source_size]
    var pack = try git.decode_pack(source)
    defer pack.close()
    let manifest_bytes = try pack_check.root_manifest(&pack, requested)
    var manifest = try pkg.decode_manifest((str)manifest_bytes)
    defer manifest.close()
    var dependencies: pkg.Dependency[128]
    for i in 0..<manifest.dependency_count: dependencies[i] = try manifest.dependency_at(i)
    var digest: u8[32]
    discard(try pkg.source_digest(source, digest))
    let release = pkg.Release(origin = origin, package = package, version = version,
        commit = commit, source_digest = digest, compiler = manifest.language,
        toolchain = toolchain)
    var metadata: u8[24576]
    let metadata_size = try pkg.encode_release_v2(release, manifest.name,
        dependencies[..<manifest.dependency_count], manifest.dependency_count, metadata)
    discard(try release_upload.sign_seed(metadata[..<metadata_size], source,
        artifact, try seed.bytes()))
    return try release_upload.upload_session(origin, artifact, try session.bytes())

pub func main(arguments: c.str[]) -> i32!:
    with memory.heap:
        if arguments.length < 2:
            try usage(io.stdout())
            return 0
        let command = (str)arguments[1]
        if command == "--version":
            try io.stdout().write(f"luc {luc_version}\n")
            return 0
        if command == "--help" or command == "help":
            try usage(io.stdout())
            return 0
        if command == "verify-release":
            # Fixed argument storage avoids the legacy command builder's allocations.
            if arguments.length < 6 or arguments.length > 7:
                error(usage_error, "usage: luc verify-release <metadata> <signature> <trusted-key> <source> [--locked]")
            var words: str[5]
            for index in 2..<arguments.length:
                words[index - 2] = (str)arguments[index]
            var no_passthrough: str[]
            return try verify_release_command(words[..<arguments.length - 2], no_passthrough)
        if command == "remote-refs":
            if arguments.length == 6 and (str)arguments[3] == "--vault" and (str)arguments[5] == "--password-stdin":
                if ((str)arguments[4]).length == 0: error(usage_error, "vault path is required")
                return try remote.refs((str)arguments[2], (str)arguments[4])
            if arguments.length != 3: error(usage_error, "usage: luc remote-refs <registry-git-url>")
            return try remote.refs((str)arguments[2])
        if command == "auth-store":
            if arguments.length != 6 or (str)arguments[5] != "--secrets-stdin":
                error(usage_error, "usage: luc auth-store <origin> <account> <new-vault> --secrets-stdin")
            return try credentials.store((str)arguments[2], (str)arguments[3], (str)arguments[4])
        if command == "release-download":
            let locked = arguments.length == 12 and (str)arguments[11] == "--locked"
            if (arguments.length != 11 and not locked) or (str)arguments[6] != "--trusted-key" or (str)arguments[8] != "--vault" or (str)arguments[10] != "--password-stdin":
                error(usage_error, "usage: luc release-download <origin> <owner/package> <version> <new-directory> --trusted-key <key> --vault <session> --password-stdin [--locked]")
            let destination = (str)arguments[5]
            if destination.length == 0: error(usage_error, "empty checkout destination")
            for byte in destination.bytes:
                if byte == 0: error(usage_error, "invalid checkout destination")
            var downloaded = try release_download.fetch((str)arguments[2], (str)arguments[3], (str)arguments[4], (str)arguments[7], (str)arguments[9])
            defer downloaded.close()
            let release = try pkg.decode_release(downloaded.metadata[..<downloaded.metadata_size])
            if locked: discard(try require_locked_release(release, downloaded.publisher_key_digest))
            var commit: u8[20]
            try git.decode_id(release.commit, commit)
            var pack = try git.decode_pack(downloaded.source[..<downloaded.source_size])
            defer pack.close()
            try checkout.materialize(&pack, commit, destination)
            try io.stdout().write("Downloaded and checked out release verified against supplied trusted key.\n")
            return 0
        if command == "versions":
            if arguments.length != 7 or (str)arguments[4] != "--vault" or (str)arguments[6] != "--password-stdin":
                error(usage_error, "usage: luc versions <origin> <owner/package> --vault <session> --password-stdin")
            return try catalog.show((str)arguments[2], (str)arguments[3], (str)arguments[5])
        if command == "resolve":
            if arguments.length != 8 or (str)arguments[5] != "--vault" or (str)arguments[7] != "--password-stdin":
                error(usage_error, "usage: luc resolve <origin> <owner/package> <version|^version> --vault <session> --password-stdin")
            return try catalog.resolve((str)arguments[2], (str)arguments[3], (str)arguments[4], (str)arguments[6])
        if command == "release-upload" or command == "release-check":
            if arguments.length != 7 or (str)arguments[4] != "--vault" or (str)arguments[6] != "--password-stdin":
                error(usage_error, "usage: luc release-upload|release-check <origin> <artifact> --vault <session> --password-stdin")
            return try release_upload.upload((str)arguments[2], (str)arguments[3], (str)arguments[5], check_only = command == "release-check")
        if command == "publish":
            if arguments.length != 13 or (str)arguments[8] != "--vault" or (str)arguments[10] != "--key-vault" or (str)arguments[12] != "--passwords-stdin":
                error(usage_error, "usage: luc publish <origin> <owner/package> <version> <commit> <toolchain> <new-artifact> --vault <session> --key-vault <key> --passwords-stdin")
            return try publish_command((str)arguments[2], (str)arguments[3], (str)arguments[4],
                (str)arguments[5], (str)arguments[6], (str)arguments[7], (str)arguments[9], (str)arguments[11])
        if command == "release-sign":
            if arguments.length != 8 or (str)arguments[5] != "--key-vault" or (str)arguments[7] != "--password-stdin":
                error(usage_error, "usage: luc release-sign <metadata> <pack> <new-upload> --key-vault <key-vault> --password-stdin")
            return try release_upload.sign((str)arguments[2], (str)arguments[3], (str)arguments[4], (str)arguments[6])
        if command == "key-create":
            if arguments.length != 6 or (str)arguments[5] != "--password-stdin":
                error(usage_error, "usage: luc key-create <origin> <account> <new-key-vault> --password-stdin")
            return try credentials.key_create((str)arguments[2], (str)arguments[3], (str)arguments[4])
        if command == "key-export":
            if arguments.length != 8 or (str)arguments[5] != "--key-vault" or (str)arguments[7] != "--password-stdin":
                error(usage_error, "usage: luc key-export <origin> <account> <new-public-key> --key-vault <key-vault> --password-stdin")
            return try credentials.key_export((str)arguments[2], (str)arguments[3], (str)arguments[4], (str)arguments[6])
        if command == "key-enroll" or command == "key-check":
            if arguments.length != 9 or (str)arguments[4] != "--vault" or (str)arguments[6] != "--key-vault" or (str)arguments[8] != "--passwords-stdin":
                error(usage_error, "usage: luc key-enroll|key-check <origin> <account> --vault <session-vault> --key-vault <key-vault> --passwords-stdin")
            return try credentials.key_enroll((str)arguments[2], (str)arguments[3], (str)arguments[5], (str)arguments[7], check_only = command == "key-check")
        if command == "login":
            if arguments.length != 6 or (str)arguments[5] != "--passwords-stdin":
                error(usage_error, "usage: luc login <origin> <account> <new-vault> --passwords-stdin")
            return try credentials.login((str)arguments[2], (str)arguments[3], (str)arguments[4])
        if command == "register":
            if arguments.length != 5 or (str)arguments[4] != "--secrets-stdin":
                error(usage_error, "usage: luc register <origin> <account> --secrets-stdin")
            return try credentials.register((str)arguments[2], (str)arguments[3])
        if command == "repo-create":
            if arguments.length != 7 or (str)arguments[4] != "--vault" or (str)arguments[6] != "--password-stdin":
                error(usage_error, "usage: luc repo-create <origin> <name> --vault <path> --password-stdin")
            return try credentials.create_repository((str)arguments[2], (str)arguments[3], (str)arguments[5])
        if command == "git-token":
            if arguments.length != 8 or (str)arguments[5] != "--vault" or (str)arguments[7] != "--password-stdin":
                error(usage_error, "usage: luc git-token <origin> <repository> <read|write> --vault <session-vault> --password-stdin")
            return try credentials.issue_git_token((str)arguments[2], (str)arguments[3],
                (str)arguments[4], (str)arguments[6])
        if command == "pr-create":
            if arguments.length != 11 or (str)arguments[8] != "--vault" or (str)arguments[10] != "--password-stdin":
                error(usage_error, "usage: luc pr-create <origin> <owner/repository> <base> <head> <title> <body> --vault <session-vault> --password-stdin")
            return try pull_requests.create((str)arguments[2], (str)arguments[3], (str)arguments[4],
                (str)arguments[5], (str)arguments[6], (str)arguments[7], (str)arguments[9])
        if command == "pr-list":
            if arguments.length != 7 or (str)arguments[4] != "--vault" or (str)arguments[6] != "--password-stdin":
                error(usage_error, "usage: luc pr-list <origin> <owner/repository> --vault <session-vault> --password-stdin")
            return try pull_requests.list((str)arguments[2], (str)arguments[3], (str)arguments[5])
        if command == "pr-show":
            if arguments.length != 8 or (str)arguments[5] != "--vault" or (str)arguments[7] != "--password-stdin":
                error(usage_error, "usage: luc pr-show <origin> <owner/repository> <number> --vault <session-vault> --password-stdin")
            return try pull_requests.show((str)arguments[2], (str)arguments[3], (str)arguments[4], (str)arguments[6])
        if command == "pr-state":
            if arguments.length != 9 or (str)arguments[6] != "--vault" or (str)arguments[8] != "--password-stdin":
                error(usage_error, "usage: luc pr-state <origin> <owner/repository> <number> <open|closed|merged> --vault <session-vault> --password-stdin")
            return try pull_requests.state((str)arguments[2], (str)arguments[3], (str)arguments[4],
                (str)arguments[5], (str)arguments[7])
        if command == "checkout-release":
            if arguments.length < 7 or arguments.length > 8:
                error(usage_error, "usage: luc checkout-release <metadata> <signature> <trusted-key> <pack> <new-directory> [--locked]")
            var words: str[6]
            for index in 2..<arguments.length: words[index - 2] = (str)arguments[index]
            return try checkout_release_command(words[..<arguments.length - 2])
        if command == "remote-fetch":
            if arguments.length == 8 and (str)arguments[5] == "--vault" and (str)arguments[7] == "--password-stdin":
                if ((str)arguments[6]).length == 0: error(usage_error, "vault path is required")
                return try remote.fetch((str)arguments[2], (str)arguments[3], (str)arguments[4], (str)arguments[6])
            if arguments.length != 5: error(usage_error, "usage: luc remote-fetch <registry-git-url> <commit-id> <new-pack-path>")
            return try remote.fetch((str)arguments[2], (str)arguments[3], (str)arguments[4])
        if command == "checkout-pack":
            if arguments.length != 5: error(usage_error, "usage: luc checkout-pack <pack-path> <commit-id> <new-directory>")
            return try checkout.from_pack((str)arguments[2], (str)arguments[3], (str)arguments[4])
        let (own, passthrough) = try partition(arguments, 2)
        defer release_string_array(own)
        defer release_string_array(passthrough)
        if command == "new" or command == "init":
            return try scaffold_command(command, own)
        if command == "update" or command == "upgrade":
            return try update_command(own)
        var project = try load_project()
        defer project.close()
        if command == "lock":
            return try lock_command(&project, own, passthrough)
        if command == "install":
            if passthrough.length != 0: error(usage_error, "install does not accept passthrough arguments")
            return try install_command(&project, own)
        if command == "sync":
            if passthrough.length != 0: error(usage_error, "sync does not accept passthrough arguments")
            let manifest = try require_manifest(&project)
            defer strings.release(manifest)
            if own.length == 5 and own[0] == "--trusted-key" and own[2] == "--vault" and own[4] == "--password-stdin":
                return try graph_sync.run(project.root, manifest, own[1], own[3])
            if own.length == 3 and own[0] == "--trusted-key" and own[2] == "--offline":
                return try graph_sync.run(project.root, manifest, own[1], offline = true)
            error(usage_error, "usage: luc sync --trusted-key <key> (--vault <session> --password-stdin | --offline)")
        if command == "add":
            return try add_command(&project, own)
        if command == "remove":
            return try remove_command(&project, own)
        if command == "clean":
            return try clean_command(&project, own)
        if command == "build":
            return try build(&project, has(own, "--release"), passthrough)
        if command == "test":
            let base = try two("test", try project.entry_path())
            return try spawn(try project.compiler(), try concat(base, passthrough))
        if command == "check":
            return try spawn(try project.compiler(), try two("check", try project.entry_path()))
        if command == "fmt":
            var formatted = try two("fmt", try project.entry_path())
            if has(own, "--check"):
                formatted = try append(formatted, "--check")
            return try spawn(try project.compiler(), formatted)
        if command == "run":
            if own.length == 0 or own[0] == "--release":
                return try run_app(&project, has(own, "--release"), passthrough)
            if project.find_task(own[0]) != none:
                return try run_task(&project, own[0], passthrough)
            try io.stderr().write(f"luc: no task named '{own[0]}'\n")
            list_tasks(&project) catch failure:
                discard(failure)
            return 1
        try io.stderr().write(f"luc: unknown command '{command}'; run 'luc help'\n")
        return 1

func usage(out: io.Writer) -> !:
    try out.write("usage: luc <command> [options] [-- args]\n\n")
    try out.write("  new <dir> [opts]      scaffold a new project (--package|--app, --luce|--luce-base)\n")
    try out.write("  init [opts]           scaffold a project in the current directory\n")
    try out.write("  add <path>            add a local package dependency to luce.toml\n")
    try out.write("  remove <name>         remove a dependency from luce.toml\n")
    try out.write("  lock --check          validate luc.lock syntax without fetching or changing files\n")
    try out.write("  lock <origin> --trusted-key <key> --vault <session> --password-stdin  resolve authenticated registry dependencies\n")
    try out.write("  install <origin> <owner/package> <version> --trusted-key <key> (--vault <session> --password-stdin | --offline) [--locked]\n")
    try out.write("  sync --trusted-key <key> (--vault <session> --password-stdin | --offline)  install exact luc.lock v3 graph\n")
    try out.write("  versions <origin> <owner/package> --vault <session> --password-stdin  list canonical available versions\n")
    try out.write("  resolve <origin> <owner/package> <version|^version> --vault <session> --password-stdin  select a catalog version\n")
    try out.write("  remote-refs <url>      list registry refs over verified production HTTPS or loopback HTTP\n")
    try out.write("  auth-store <origin> <account> <new-vault> --secrets-stdin  encrypt a session token\n")
    try out.write("  release-sign <metadata> <pack> <new-upload> --key-vault <key> --password-stdin  save signed LRP1 artifact\n")
    try out.write("  release-upload|release-check <origin> <artifact> --vault <session> --password-stdin  publish or reconcile exact release bytes\n")
    try out.write("  publish <origin> <owner/package> <version> <commit> <toolchain> <new-artifact> --vault <session> --key-vault <key> --passwords-stdin\n")
    try out.write("  release-download <origin> <owner/package> <version> <new-directory> --trusted-key <key> --vault <session> --password-stdin [--locked]\n")
    try out.write("  key-create <origin> <account> <new-key-vault> --password-stdin  save an encrypted signing seed\n")
    try out.write("  key-export <origin> <account> <new-public-key> --key-vault <key> --password-stdin  derive an offline trust anchor\n")
    try out.write("  key-enroll <origin> <account> --vault <session> --key-vault <key> --passwords-stdin  enroll signing key\n")
    try out.write("  key-check <origin> <account> --vault <session> --key-vault <key> --passwords-stdin  compare enrolled key without mutation\n")
    try out.write("  login <origin> <account> <new-vault> --passwords-stdin  log in and encrypt the session\n")
    try out.write("  register <origin> <account> --secrets-stdin  redeem an invitation\n")
    try out.write("  repo-create <origin> <name> --vault <path> --password-stdin  create a remote repository\n")
    try out.write("  git-token <origin> <repository> <read|write> --vault <path> --password-stdin  mint a five-minute stock-Git password\n")
    try out.write("  pr-create <origin> <owner/repository> <base> <head> <title> <body> --vault <path> --password-stdin  open a same-repository review\n")
    try out.write("  pr-list <origin> <owner/repository> --vault <path> --password-stdin  list pull requests as JSON\n")
    try out.write("  pr-show <origin> <owner/repository> <number> --vault <path> --password-stdin  show one pull request\n")
    try out.write("  pr-state <origin> <owner/repository> <number> <open|closed|merged> --vault <path> --password-stdin  change review state\n")
    try out.write("  remote-refs/remote-fetch also accept --vault <path> --password-stdin\n")
    try out.write("  remote-fetch <url> <commit> <new-pack-path>  fetch a validated full Git pack\n")
    try out.write("  checkout-pack <pack> <commit> <new-directory>  materialize validated source\n")
    try out.write("  checkout-release <metadata> <signature> <key> <pack> <new-directory> [--locked]\n")
    try out.write("  verify-release <metadata> <signature> <trusted-key> <source> [--locked]\n")
    try out.write("                        verify local release bytes against a supplied ML-DSA-65 key\n")
    try out.write("  build [--release]     build the project into build/<name>\n")
    try out.write("  run [--release]       build and run the project\n")
    try out.write("  run <task>            run a named [tasks] workflow from luce.toml\n")
    try out.write("  test                  build and run the project's tests\n")
    try out.write("  check                 type-check without producing a binary\n")
    try out.write("  fmt [--check]         format the project's sources\n")
    try out.write("  clean [cache]         remove build/ (or, with cache, only the build cache)\n")
    try out.write("  update | upgrade      reinstall the latest luc, luce-base and luce\n")
    try out.write("  --version             print the luc version\n")
    try out.write("  help                  show this message\n")
