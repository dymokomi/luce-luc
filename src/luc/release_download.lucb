## Fetch exact release bytes; caller supplies publisher trust independently.
import pkg
import crypto_native as crypto
import luc.credentials as credentials
import luc.registry_http as registry
import files
import strings
import memory
import c
import paths
import io

let invalid: ErrorCode = ErrorCode.package(7)
let max_artifact: usize = 67108864 + pkg.max_release_metadata + 3309 + 8

pub struct Download:
    ## Nonempty only for a loaded cache artifact; component slices borrow it.
    pub var storage: u8[]
    pub var metadata: u8[]
    pub var signature: u8[]
    pub var source: u8[]
    pub var metadata_size: usize
    pub var source_size: usize
    ## SHA-256 of the exact public key used for release verification.
    pub var publisher_key_digest: u8[32]
    pub mutating func close():
        if self.storage.length > 0:
            free(self.storage) in memory.heap
        else:
            if self.metadata.length > 0: free(self.metadata) in memory.heap
            if self.signature.length > 0: free(self.signature) in memory.heap
            if self.source.length > 0: free(self.source) in memory.heap
        var empty: u8[]
        self.storage = empty
        self.metadata = empty
        self.signature = empty
        self.source = empty

## Signed release metadata authenticated by the caller's explicit publisher key.
## Source bytes have not been fetched or digest-verified yet.
pub struct Metadata:
    var storage: u8[]
    pub var signature: u8[]
    pub var release: pkg.Release
    pub var publisher_key_digest: u8[32]

    pub func bytes() -> const u8[]:
        return self.storage

    pub mutating func close():
        if self.storage.length > 0: free(self.storage) in memory.heap
        if self.signature.length > 0: free(self.signature) in memory.heap
        var empty: u8[]
        self.storage = empty
        self.signature = empty

pub func trusted_key(path: str) -> u8[]!:
    let filename = try strings.copy(path)
    defer strings.release(filename)
    let key = try files.read_limit((c.str)filename, 1952)
    if key.length != 1952:
        free(key) in memory.heap
        error(invalid, "trusted key must contain exactly1952 bytes")
    return key

func identity(release: pkg.Release, origin: str, package: str, version: str) -> !:
    if release.origin != origin or release.package != package or release.version != version:
        error(invalid, "release identity mismatch")
    discard(try pkg.parse_version(release.toolchain))

pub func validate_request(origin: str, package: str, version: str) -> !:
    discard(try registry.parse(origin))
    var split: usize = 0
    while split < package.length and package.bytes[split] != '/': split += 1
    if split == 0 or split > 32 or split == package.length: error(invalid, "invalid package identity")
    let owner = (str)package.bytes[..<split]
    let name = (str)package.bytes[split + 1..]
    if name.length == 0 or name.length > 64: error(invalid, "invalid package name")
    for byte in owner.bytes:
        if not ((byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9') or byte == '_'):
            error(invalid, "invalid package owner")
    for i in 0..<name.length:
        let byte = name.bytes[i]
        let alnum = (byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9')
        if not alnum and (i == 0 or (byte != '_' and byte != '-')): error(invalid, "invalid package name")
    discard(try pkg.parse_version(version))

## Fetch and authenticate only the bounded signed declaration. This is sufficient
## for graph resolution; selected source still requires fetch_authenticated().
pub func fetch_metadata_authenticated(origin: str, package: str, version: str,
                                      key: const u8[], token: const u8[]) -> Metadata!:
    try validate_request(origin, package, version)
    if key.length != 1952: error(invalid, "trusted key must contain exactly1952 bytes")
    if token.length != 32: error(invalid, "invalid registry session token")
    var bearer_buffer: u8[80]
    defer crypto.wipe(bearer_buffer)
    let bearer = try format(bearer_buffer, f"Bearer {(str)token}")
    var path_buffer: u8[384]
    let path = try format(path_buffer, f"/v1/releases/{package}/{version}/metadata")
    let scratch = try alloc u8[pkg.max_release_metadata] in memory.heap
    defer free(scratch) in memory.heap
    let meta_result = try registry.request(origin, "GET", path, bearer, "", b"", scratch)
    if meta_result.status != 200: error(invalid, "release metadata download failed")
    let metadata = try alloc u8[meta_result.count] in memory.heap
    errdefer free(metadata) in memory.heap
    for i in 0..<meta_result.count: metadata[i] = scratch[i]
    let release = try pkg.decode_release(metadata[..<meta_result.count])
    try identity(release, origin, package, version)
    var signature_path: u8[384]
    let sig_path = try format(signature_path, f"/v1/releases/{package}/{version}/signature")
    let signature = try alloc u8[3309] in memory.heap
    errdefer free(signature) in memory.heap
    let sig_result = try registry.request(origin, "GET", sig_path, bearer, "", b"", signature)
    if sig_result.status != 200 or sig_result.count != signature.length: error(invalid, "release signature download failed")
    if not try crypto.mldsa_verify(key, metadata[..<meta_result.count], signature):
        error(invalid, "release signature does not match supplied trusted key")
    var key_digest: u8[32]
    discard(try crypto.digest(key, key_digest, "sha256"))
    return Metadata(storage = metadata, signature = signature, release = release,
        publisher_key_digest = key_digest)

pub func fetch_authenticated(origin: str, package: str, version: str,
                             key: const u8[], token: const u8[]) -> Download!:
    var metadata = try fetch_metadata_authenticated(origin, package, version, key, token)
    errdefer metadata.close()
    var bearer_buffer: u8[80]
    defer crypto.wipe(bearer_buffer)
    let bearer = try format(bearer_buffer, f"Bearer {(str)token}")
    let source = try alloc u8[67108864] in memory.heap
    errdefer free(source) in memory.heap
    var source_path: u8[384]
    let src_path = try format(source_path, f"/v1/releases/{package}/{version}/source")
    let src_result = try registry.request(origin, "GET", src_path, bearer, "", b"", source)
    if src_result.status != 200: error(invalid, "release source download failed")
    if not try pkg.verify_release(metadata.release, key, metadata.signature, source[..<src_result.count]):
        error(invalid, "downloaded release source verification failed")
    let result = Download(metadata = metadata.storage, signature = metadata.signature, source = source,
        metadata_size = metadata.storage.length, source_size = src_result.count,
        publisher_key_digest = metadata.publisher_key_digest)
    var empty: u8[]
    metadata.storage = empty
    metadata.signature = empty
    return result

pub func fetch(origin: str, package: str, version: str, key_path: str, vault_path: str) -> Download!:
    let key = try trusted_key(key_path)
    defer free(key) in memory.heap
    # Credential loading validates the exact origin before any network request.
    var token = try credentials.load(vault_path, origin)
    defer token.close()
    return try fetch_authenticated(origin, package, version, key, try token.bytes())

## Load and verify an exact cached LRP1 artifact without network access.
pub func load_cache_authenticated(path: str, origin: str, package: str, version: str,
                                  key: const u8[]) -> Download!:
    try validate_request(origin, package, version)
    if key.length != 1952: error(invalid, "trusted key must contain exactly1952 bytes")
    let filename = try strings.copy(path)
    defer strings.release(filename)
    let directory_name = try strings.copy(paths.directory(filename))
    defer strings.release(directory_name)
    let entry_name = try strings.copy(paths.base(filename))
    defer strings.release(entry_name)
    var directory = try files.Directory.open((c.str)directory_name, follow_symlinks = false)
    defer directory.destroy()
    var file = try directory.open_file((c.str)entry_name, follow_symlinks = false, nonblocking = true)
    defer file.destroy()
    let info = try file.metadata()
    if info.kind != files.FileKind.regular or info.size < 3367 or info.size > (i64)max_artifact:
        error(invalid, "cached release must be a bounded regular file")
    let wire = try alloc u8[(usize)info.size] in memory.heap
    errdefer free(wire) in memory.heap
    var read: usize = 0
    while read < wire.length:
        let count = try file.read(wire[read..])
        if count == 0: error(invalid, "cached release was truncated while reading")
        read += count
    var extra: u8[1]
    if try file.read(extra) != 0: error(invalid, "cached release changed while reading")
    try file.close()
    if wire.length < 3367 or (str)wire[..<4] != "LRP1" or wire[6] != 0 or wire[7] != 0:
        error(invalid, "invalid cached release envelope")
    let size = (usize)wire[4] + ((usize)wire[5] << 8)
    if size < 50 or size > pkg.max_release_metadata or wire.length < 8 + size + 3309:
        error(invalid, "invalid cached release lengths")
    let metadata = wire[8..<8 + size]
    let signature = wire[8 + size..<3317 + size]
    let source = wire[3317 + size..]
    if source.length > 67108864: error(invalid, "cached release source too large")
    let release = try pkg.decode_release(metadata)
    try identity(release, origin, package, version)
    if not try pkg.verify_release(release, key, signature, source):
        error(invalid, "cached release does not verify against supplied trusted key")
    var key_digest: u8[32]
    discard(try crypto.digest(key, key_digest, "sha256"))
    return Download(storage = wire, metadata = metadata, signature = signature, source = source,
        metadata_size = metadata.length, source_size = source.length,
        publisher_key_digest = key_digest)

pub func load_cache(path: str, origin: str, package: str, version: str, key_path: str) -> Download!:
    let key = try trusted_key(key_path)
    defer free(key) in memory.heap
    return try load_cache_authenticated(path, origin, package, version, key)

## Atomically publish exact verified bytes into an existing cache directory.
## An existing destination is refused; callers reconcile it independently.
pub func save_cache(download: Download*, path: str) -> !:
    if download.metadata_size < 50 or download.metadata_size > pkg.max_release_metadata or download.signature.length != 3309 or download.source_size > 67108864:
        error(invalid, "invalid release cache components")
    let filename = try strings.copy(path)
    defer strings.release(filename)
    let parent_name = try strings.copy(paths.directory(filename))
    defer strings.release(parent_name)
    var parent = try files.Directory.open((c.str)parent_name, follow_symlinks = false)
    defer parent.destroy()
    var parent_file = try files.File.open((c.str)parent_name)
    defer parent_file.destroy()
    var temporary = try files.TemporaryFile.create((c.str)parent_name, permissions = 384)
    defer temporary.destroy()
    var header: u8[8]
    header[0] = 'L'
    header[1] = 'R'
    header[2] = 'P'
    header[3] = '1'
    header[4] = (u8)(download.metadata_size & 255)
    header[5] = (u8)(download.metadata_size >> 8)
    try io.write_all(&temporary, header)
    try io.write_all(&temporary, download.metadata[..<download.metadata_size])
    try io.write_all(&temporary, download.signature)
    try io.write_all(&temporary, download.source[..<download.source_size])
    try temporary.sync()
    try temporary.publish((c.str)filename, replace = false)
    try parent_file.sync()
    try parent_file.close()

pub func same(left: Download*, right: Download*) -> bool:
    if left.metadata_size != right.metadata_size or left.source_size != right.source_size: return false
    if not crypto.equal(left.metadata[..<left.metadata_size], right.metadata[..<right.metadata_size]): return false
    if not crypto.equal(left.signature, right.signature): return false
    if not crypto.equal(left.publisher_key_digest, right.publisher_key_digest): return false
    return crypto.equal(left.source[..<left.source_size], right.source[..<right.source_size])
