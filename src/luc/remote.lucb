## Native Git smart-HTTP transport over canonical loopback HTTP or verified
## production HTTPS.
import git
import os
import c
import strings
import memory
import io
import files
import paths
import crypto_native
import luc.pack_check as pack_check
import luc.credentials as credentials
import luc.registry_http as registry

let invalid: ErrorCode = ErrorCode.package(2)

func component(value: str, owner: bool) -> bool:
    if value.length == 0 or value.length > (32 if owner else 64): return false
    for i in 0..<value.length:
        let byte = value.bytes[i]
        let alnum = (byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9')
        if not alnum and byte != '_' and (owner or byte != '-'): return false
        if not owner and i == 0 and not alnum: return false
    return true

## Validate the complete advertisement before printing any untrusted server text.
func advertisement(wire: const u8[], emit: bool, wanted: const u8[]) -> bool!:
    var found = false
    let service = try git.decode_packet(wire)
    if service.kind != git.PacketKind.data or (str)service.payload != "# service=git-upload-pack\n":
        error(invalid, "invalid Git service advertisement")
    var at = service.consumed
    let separator = try git.decode_packet(wire[at..])
    if separator.kind != git.PacketKind.flush: error(invalid, "missing Git service flush")
    at += separator.consumed
    var count: usize = 0
    var empty = false
    while at < wire.length:
        let packet = try git.decode_packet(wire[at..])
        at += packet.consumed
        if packet.kind == git.PacketKind.flush:
            if at != wire.length or count == 0: error(invalid, "invalid Git discovery end")
            return found
        if packet.kind != git.PacketKind.data or count >= 2049 or empty:
            error(invalid, "invalid Git discovery packet")
        var line = packet.payload
        if line.length > 0 and line[line.length - 1] == '\n': line = line[..<line.length - 1]
        var end: usize = 0
        while end < line.length and line[end] != 0: end += 1
        if count == 0:
            if end == line.length: error(invalid, "missing Git discovery capabilities")
            if line.length - end - 1 > 4096: error(invalid, "Git discovery capabilities too large")
            for i in end + 1..<line.length:
                if line[i] < 32 or line[i] > 126: error(invalid, "invalid Git capability text")
        elif end != line.length: error(invalid, "unexpected Git capability field")
        if end < 42 or line[40] != ' ': error(invalid, "invalid advertised identity")
        let identity = (str)line[..<40]
        var id: u8[20]
        try git.decode_id(identity, id)
        if wanted.length == 20 and crypto_native.equal(id, wanted): found = true
        let name = (str)line[41..<end]
        var zero = true
        for byte in id:
            if byte != 0: zero = false
        if zero:
            if count != 0 or name != "capabilities^{}": error(invalid, "invalid null advertised identity")
            empty = true
        else:
            var ref = name
            if strings.ends_with(ref, "^{}"): ref = (str)ref.bytes[..<ref.length - 3]
            if name != "HEAD" and not git.valid_ref(ref): error(invalid, "invalid advertised ref")
            if emit: try io.stdout().write(f"{identity}\t{name}\n")
        count += 1
    error(invalid, "missing Git discovery flush")

pub func refs(url: str, vault_path: str = "") -> i32!:
    return try run(url, "", "", vault_path)

pub func fetch(url: str, commit: str, destination: str, vault_path: str = "") -> i32!:
    if commit.length != 40 or destination.length == 0: error(invalid, "invalid fetch commit or destination")
    for byte in destination.bytes:
        if byte == 0: error(invalid, "invalid destination path")
    return try run(url, commit, destination, vault_path)

func run(url: str, commit: str, destination: str, vault_path: str) -> i32!:
    var requested: u8[20]
    if commit.length > 0: try git.decode_id(commit, requested)
    let at = try registry.url_origin_length(url)
    let origin = (str)url.bytes[..<at]
    let path = (str)url.bytes[at..]
    if not strings.starts_with(path, "/git/"): error(invalid, "invalid registry repository URL")
    var split: usize = 5
    while split < path.length and path.bytes[split] != '/': split += 1
    if split == path.length: error(invalid, "missing registry package name")
    if not component((str)path.bytes[5..<split], true) or not component((str)path.bytes[split + 1..], false):
        error(invalid, "invalid registry owner or package name")
    var secret = crypto_native.Secret()
    defer secret.close()
    var token: str
    if vault_path.length > 0:
        secret = try credentials.load(vault_path, origin)
        token = (str)try secret.bytes()
    else:
        token = os.env((c.str)"LUCE_REGISTRY_TOKEN") else error(invalid, "LUCE_REGISTRY_TOKEN is required")
    if token.length != 32: error(invalid, "invalid registry session token")
    for byte in token.bytes:
        if not ((byte >= '0' and byte <= '9') or (byte >= 'a' and byte <= 'f')):
            error(invalid, "invalid registry session token")
    var target_buffer: u8[256]
    let target = try format(target_buffer, f"{path}/info/refs?service=git-upload-pack")
    var credential: u8[80]
    defer crypto_native.wipe(credential)
    let bearer = try format(credential, f"Bearer {token}")
    let output = try alloc u8[4194304] in memory.heap
    defer free(output) in memory.heap
    let result = try registry.request(origin, "GET", target, bearer, "", b"", output)
    if result.status != 200: error(invalid, "registry discovery request failed")
    if commit.length == 0:
        discard(try advertisement(output[..<result.count], false, b""))
        discard(try advertisement(output[..<result.count], true, b""))
        return 0
    if not try advertisement(output[..<result.count], false, requested): error(invalid, "requested commit is not advertised")
    var encoded: u8[40]
    discard(try git.hex_id(requested, encoded))
    var line_buffer: u8[64]
    let line = try format(line_buffer, f"want {(str)encoded}\n")
    var request: u8[128]
    var size = try git.encode_packet(git.PacketKind.data, line.bytes, request)
    size += try git.encode_packet(git.PacketKind.flush, b"", request[size..])
    size += try git.encode_packet(git.PacketKind.data, b"done\n", request[size..])
    var fetch_target: u8[256]
    let endpoint = try format(fetch_target, f"{path}/git-upload-pack")
    let incoming = try alloc u8[67108864] in memory.heap
    defer free(incoming) in memory.heap
    let response = try registry.request(origin, "POST", endpoint, bearer,
        "application/x-git-upload-pack-request", request[..<size], incoming)
    if response.status != 200: error(invalid, "registry fetch request failed")
    let acknowledgement = try git.decode_packet(incoming[..<response.count])
    if acknowledgement.kind != git.PacketKind.data or (str)acknowledgement.payload != "NAK\n":
        error(invalid, "invalid initial fetch acknowledgement")
    let wire = incoming[acknowledgement.consumed..<response.count]
    var pack = try git.decode_pack(wire)
    defer pack.close()
    try pack_check.validate(&pack, requested)
    # No destination entry is created until all protocol and graph checks pass.
    let filename = try strings.copy(destination)
    defer strings.release(filename)
    let directory = paths.directory(filename)
    let parent = try strings.copy(directory if directory.length > 0 else ".")
    defer strings.release(parent)
    var temporary = try files.TemporaryFile.create((c.str)parent)
    defer temporary.destroy()
    try io.write_all(&temporary, wire)
    try temporary.sync()
    try temporary.publish((c.str)filename, replace = false)
    try io.stdout().write("downloaded validated Git pack (release signature not verified)\n")
    return 0
