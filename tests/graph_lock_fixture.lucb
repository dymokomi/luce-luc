## Deterministic TEST ONLY graph signer; never use this identity in production.
import pkg
import crypto_native as crypto
import files
import paths
import strings
import c

func write(root: str, name: str, bytes: const u8[]) -> !:
    let path = try paths.join(root, name)
    defer strings.release(path)
    try files.write((c.str)path, bytes)

func signed(root: str, origin: str, stem: str, package: str, version: str,
            package_name: str, marker: u8, dependencies: const pkg.Dependency[], count: usize,
            secret: const u8[]) -> !:
    var digest: u8[32]
    digest[0] = marker
    var commit: u8[40]
    for i in 0..<commit.length: commit[i] = '0'
    commit[39] = '0' + marker
    let release = pkg.Release(origin = origin, package = package, version = version,
        commit = (str)commit, source_digest = digest, compiler = "luce-base", toolchain = "0.20.0")
    var metadata: u8[24576]
    let size = try pkg.encode_release_v2(release, package_name, dependencies, count, metadata)
    var random: u8[32]
    var signature: u8[3309]
    try crypto.mldsa_sign(secret, metadata[..<size], random, signature)
    var metadata_name: u8[96]
    var signature_name: u8[96]
    try write(root, try format(metadata_name, f"{stem}-metadata"), metadata[..<size])
    try write(root, try format(signature_name, f"{stem}-signature"), signature)

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 3)
    var seed: u8[32]
    var key: u8[1952]
    var secret: u8[4032]
    defer crypto.wipe(secret)
    try crypto.mldsa_keygen(seed, key, secret)
    try write(arguments[1], "key", key)
    var a_new: pkg.Dependency[1]
    a_new[0] = pkg.Dependency(package = "acme/b", requirement = "^2.0.0")
    var a_old: pkg.Dependency[1]
    a_old[0] = pkg.Dependency(package = "acme/b", requirement = "^1.0.0")
    var c_dependency: pkg.Dependency[1]
    c_dependency[0] = pkg.Dependency(package = "acme/b", requirement = "1.5.0")
    var no_dependencies: pkg.Dependency[1]
    try signed(arguments[1], arguments[2], "a-1.1.0", "acme/a", "1.1.0", "a_lib", 1, a_new, 1, secret)
    try signed(arguments[1], arguments[2], "a-1.0.0", "acme/a", "1.0.0", "a_lib", 2, a_old, 1, secret)
    try signed(arguments[1], arguments[2], "b-2.0.0", "acme/b", "2.0.0", "b_lib", 3, no_dependencies[..<0], 0, secret)
    try signed(arguments[1], arguments[2], "b-1.5.0", "acme/b", "1.5.0", "b_lib", 4, no_dependencies[..<0], 0, secret)
    try signed(arguments[1], arguments[2], "c-1.0.0", "acme/c", "1.0.0", "c_lib", 5, c_dependency, 1, secret)
    return 0
