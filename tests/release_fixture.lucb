## Deterministic TEST ONLY keys; never use this fixture for real credentials.
import pkg
import crypto_native
import files
import c
import paths
import strings

func write(root: str, name: str, data: const u8[]) -> !:
    let path = try strings.copy(try paths.join(root, name))
    try files.write((c.str)path, data)

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    let root = arguments[1]
    var seed: u8[32]
    var pk: u8[1952]
    var sk: u8[4032]
    defer crypto_native.wipe(sk)
    try crypto_native.mldsa_keygen(seed, pk, sk)
    var digest: u8[32]
    let source = b"source fixture"
    discard(try pkg.source_digest(source, digest))
    let release = pkg.Release(origin = "https://pkg.luciaos.com", package = "acme/demo", version = "1.2.3", commit = "0123456789012345678901234567890123456789", source_digest = digest, compiler = "luce-base", toolchain = "0.20.0")
    var wire: u8[24576]
    let size = try pkg.encode_release(release, wire)
    var randomness: u8[32]
    var signature: u8[3309]
    try crypto_native.mldsa_sign(sk, wire[..<size], randomness, signature)
    try write(root, "metadata", wire[..<size])
    try write(root, "signature", signature)
    try write(root, "key", pk)
    try write(root, "source", source)
    var no_dependencies: pkg.Dependency[1]
    let v2_size = try pkg.encode_release_v2(release, "demo", no_dependencies[..<0], 0, wire)
    try crypto_native.mldsa_sign(sk, wire[..<v2_size], randomness, signature)
    try write(root, "metadata-v2", wire[..<v2_size])
    try write(root, "signature-v2", signature)
    return 0
