## Test-only verifier for a random key created by the CLI, no foreign crypto.
import credential_files as vault
import account_identity as keys
import pkg
import crypto_native as crypto
import files
import memory
import c

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 3)
    var secret = try vault.open(arguments[1], b"signer-test-password")
    defer secret.close()
    let wire = try files.read_limit((c.str)arguments[2], 67108864 + pkg.max_release_metadata + 3309 + 8)
    defer free(wire) in memory.heap
    assert(wire.length > 3317 and (str)wire[..<4] == "LRP1" and wire[6] == 0 and wire[7] == 0)
    let size = (usize)wire[4] | ((usize)wire[5] << 8)
    let release = try pkg.decode_release(wire[8..<8 + size])
    let plaintext = try secret.bytes()
    var prefix_buffer: u8[128]
    let prefix = try format(prefix_buffer, f"LUK1\n{release.origin}\nalice\n")
    assert(plaintext.length == prefix.length + 32)
    assert(crypto.equal(plaintext[..<prefix.length], prefix.bytes))
    var key: u8[1952]
    try keys.public_key(plaintext[prefix.length..], key)
    assert(try pkg.verify_release(release, key, wire[8 + size..<3317 + size], wire[3317 + size..]))
    print("PASS random vault key verifies persisted LRP1 artifact")
    return 0
